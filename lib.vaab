to studio_meta() returns StudioMeta {
    match env.get("AUTH_SECRET") {
        when found _ then {
            return StudioMeta.new(auth_secret_set: yes, can_patch: yes, can_insert: yes)
        }
        when nothing then {
            return StudioMeta.new(auth_secret_set: no, can_patch: yes, can_insert: yes)
        }
    }
}

to flag_text(value: Bool) returns Text {
    if value {
        return "true"
    }
    return "false"
}

to flag_bool(value: Text, fallback: Bool) returns Bool {
    if value == "true" {
        return yes
    }
    if value == "false" {
        return no
    }
    return fallback
}

to nonempty(value: Text, fallback: Text) returns Text {
    if value.is_empty {
        return fallback
    }
    return value
}

to has_text(value: Text) returns Bool {
    if value.is_empty {
        return no
    }
    return yes
}

to config_get(db: Db, key: Text) returns Text or fails RigError {
    match db.from("studio_config").equals("key", key).first() {
        when success maybe then match maybe {
            when found row then match row.get("value") {
                when found value then { return value }
                when nothing then { return "" }
            }
            when nothing then { return "" }
        }
        when failure error then match error {
            when Failed(message) then { fail RigError.Database(message) }
        }
    }
}

to config_set(db: Db, key: Text, value: Text) returns Int or fails RigError {
    match db.from("studio_config").equals("key", key).first() {
        when success maybe then match maybe {
            when found _ then match db.from("studio_config").equals("key", key).update({"value": value}) {
                when success count then { return count }
                when failure error then match error {
                    when Failed(message) then { fail RigError.Database(message) }
                }
            }
            when nothing then match db.from("studio_config").insert({"key": key, "value": value}) {
                when success count then { return count }
                when failure error then match error {
                    when Failed(message) then { fail RigError.Database(message) }
                }
            }
        }
        when failure error then match error {
            when Failed(message) then { fail RigError.Database(message) }
        }
    }
}

to keep_or_set(db: Db, key: Text, incoming: Text) returns Text or fails RigError {
    if incoming.is_empty {
        return try config_get(db, key)
    }
    let _count = try config_set(db, key, incoming)
    return incoming
}

to auth_view_from_db(db: Db) returns StudioAuthConfigView or fails RigError {
    let email_raw = try config_get(db, "email_enabled")
    let magic_raw = try config_get(db, "magic_link_enabled")
    let google_on = try config_get(db, "google_enabled")
    let github_on = try config_get(db, "github_enabled")
    let google_secret = try config_get(db, "google_client_secret")
    let github_secret = try config_get(db, "github_client_secret")
    let min_len = try config_get(db, "min_password_length")
    let google_id = try config_get(db, "google_client_id")
    let google_last4 = try config_get(db, "google_client_secret_last4")
    let github_id = try config_get(db, "github_client_id")
    let github_last4 = try config_get(db, "github_client_secret_last4")
    let site = try config_get(db, "site_url")
    let redirects = try config_get(db, "redirect_urls")
    let anon_raw = try config_get(db, "anonymous_enabled")
    let confirm_raw = try config_get(db, "confirm_email")
    let phone_raw = try config_get(db, "phone_enabled")
    let custom_on = try config_get(db, "custom_oauth_enabled")
    let custom_name = try config_get(db, "custom_oauth_name")
    let custom_id = try config_get(db, "custom_oauth_client_id")
    let custom_secret = try config_get(db, "custom_oauth_client_secret")
    let custom_last4 = try config_get(db, "custom_oauth_client_secret_last4")
    let custom_url = try config_get(db, "custom_oauth_url")
    let smtp_host = try config_get(db, "smtp_host")
    let smtp_port = try config_get(db, "smtp_port")
    let smtp_user = try config_get(db, "smtp_user")
    let smtp_pass = try config_get(db, "smtp_pass")
    let smtp_admin = try config_get(db, "smtp_admin_email")
    let smtp_sender = try config_get(db, "smtp_sender_name")
    let rate_email = try config_get(db, "rate_limit_email")
    let rate_token = try config_get(db, "rate_limit_token")
    let jwt_expiry = try config_get(db, "jwt_expiry")
    return StudioAuthConfigView.new(
        email_enabled: flag_bool(email_raw, yes),
        min_password_length: nonempty(min_len, "8"),
        magic_link_enabled: flag_bool(magic_raw, no),
        google_enabled: flag_bool(google_on, no),
        google_client_id: google_id,
        google_has_secret: has_text(google_secret),
        google_client_secret_last4: google_last4,
        github_enabled: flag_bool(github_on, no),
        github_client_id: github_id,
        github_has_secret: has_text(github_secret),
        github_client_secret_last4: github_last4,
        site_url: site,
        redirect_urls: redirects,
        anonymous_enabled: flag_bool(anon_raw, no),
        confirm_email: flag_bool(confirm_raw, yes),
        phone_enabled: flag_bool(phone_raw, no),
        custom_oauth_enabled: flag_bool(custom_on, no),
        custom_oauth_name: custom_name,
        custom_oauth_client_id: custom_id,
        custom_oauth_has_secret: has_text(custom_secret),
        custom_oauth_client_secret_last4: custom_last4,
        custom_oauth_url: custom_url,
        smtp_host: smtp_host,
        smtp_port: nonempty(smtp_port, "587"),
        smtp_user: smtp_user,
        smtp_has_pass: has_text(smtp_pass),
        smtp_admin_email: smtp_admin,
        smtp_sender_name: smtp_sender,
        rate_limit_email: nonempty(rate_email, "30"),
        rate_limit_token: nonempty(rate_token, "30"),
        jwt_expiry: nonempty(jwt_expiry, "3600"),
    )
}

to get_auth_config(db: Db) returns StudioAuthConfigView or fails RigError {
    return try auth_view_from_db(db)
}

to put_auth_config(db: Db, incoming: StudioAuthConfigBody) returns StudioAuthConfigView or fails RigError {
    let _e = try config_set(db, "email_enabled", flag_text(incoming.email_enabled))
    let _m = try config_set(db, "min_password_length", incoming.min_password_length)
    let _ml = try config_set(db, "magic_link_enabled", flag_text(incoming.magic_link_enabled))
    let _ge = try config_set(db, "google_enabled", flag_text(incoming.google_enabled))
    let _gi = try config_set(db, "google_client_id", incoming.google_client_id)
    let _gs = try keep_or_set(db, "google_client_secret", incoming.google_client_secret)
    if not incoming.google_client_secret.is_empty {
        let _g4 = try config_set(db, "google_client_secret_last4", incoming.google_client_secret_last4)
    }
    let _he = try config_set(db, "github_enabled", flag_text(incoming.github_enabled))
    let _hi = try config_set(db, "github_client_id", incoming.github_client_id)
    let _hs = try keep_or_set(db, "github_client_secret", incoming.github_client_secret)
    if not incoming.github_client_secret.is_empty {
        let _h4 = try config_set(db, "github_client_secret_last4", incoming.github_client_secret_last4)
    }
    let _su = try config_set(db, "site_url", incoming.site_url)
    let _ru = try config_set(db, "redirect_urls", incoming.redirect_urls)
    let _an = try config_set(db, "anonymous_enabled", flag_text(incoming.anonymous_enabled))
    let _ce = try config_set(db, "confirm_email", flag_text(incoming.confirm_email))
    let _ph = try config_set(db, "phone_enabled", flag_text(incoming.phone_enabled))
    let _co = try config_set(db, "custom_oauth_enabled", flag_text(incoming.custom_oauth_enabled))
    let _cn = try config_set(db, "custom_oauth_name", incoming.custom_oauth_name)
    let _ci = try config_set(db, "custom_oauth_client_id", incoming.custom_oauth_client_id)
    let _cs = try keep_or_set(db, "custom_oauth_client_secret", incoming.custom_oauth_client_secret)
    if not incoming.custom_oauth_client_secret.is_empty {
        let _c4 = try config_set(db, "custom_oauth_client_secret_last4", incoming.custom_oauth_client_secret_last4)
    }
    let _cu = try config_set(db, "custom_oauth_url", incoming.custom_oauth_url)
    let _sh = try config_set(db, "smtp_host", incoming.smtp_host)
    let _sp = try config_set(db, "smtp_port", incoming.smtp_port)
    let _sm = try config_set(db, "smtp_user", incoming.smtp_user)
    let _ss = try keep_or_set(db, "smtp_pass", incoming.smtp_pass)
    let _sa = try config_set(db, "smtp_admin_email", incoming.smtp_admin_email)
    let _sn = try config_set(db, "smtp_sender_name", incoming.smtp_sender_name)
    let _re = try config_set(db, "rate_limit_email", incoming.rate_limit_email)
    let _rt = try config_set(db, "rate_limit_token", incoming.rate_limit_token)
    let _jw = try config_set(db, "jwt_expiry", incoming.jwt_expiry)
    return try auth_view_from_db(db)
}

to insert_studio_row(db: Db, body: StudioInsertBody) returns Int or fails RigError {
    let table = try allow_studio_table(db, body.table)
    let pk = primary_key(db, table)
    let row_id = nonempty(body.id, nonempty(body.email, nonempty(body.name, "row-{now()}")))
    if table == "profiles" {
        match db.from("profiles").insert({"id": row_id, "email": body.email, "name": body.name}) {
            when success count then { return count }
            when failure error then match error {
                when Failed(message) then { fail RigError.Database(message) }
            }
        }
    }
    match db.from(table).insert({pk: row_id}) {
        when success count then { return count }
        when failure error then match error {
            when Failed(message) then { fail RigError.Database(message) }
        }
    }
}

to patch_studio_row(db: Db, body: StudioPatchBody, actor: Actor) returns Int or fails RigError {
    let table = try allow_studio_table(db, body.table)
    if body.id.is_empty {
        fail RigError.BadRequest("id required")
    }
    let col = try ident(body.column)
    let _existing = try assert_existing(db, table, "update", actor, body.id)
    let mode = try rls_mode(db, table, "update", actor)
    if mode.kind == "uid" and col == mode.column and body.value != actor.uid {
        fail RigError.Forbidden(table)
    }
    let pk = primary_key(db, table)
    match db.from(table).equals(pk, body.id).update({col: body.value}) {
        when success count then {
            if count == 0 { fail RigError.NotFound(body.id) }
            return count
        }
        when failure error then match error {
            when Failed(message) then { fail RigError.Database(message) }
        }
    }
}

# --- Studio operator API (introspection, SQL, generic rows, extras) ----------

to table_count(db: Db, name: Text) returns Text {
    match db.from(name).count() {
        when success n then { return "{n}" }
        when failure _ then { return "0" }
    }
}

to rls_flag(db: Db, table_name: Text) returns Text {
    match config_get(db, "rls:{table_name}") {
        when success value then { return nonempty(value, "false") }
        when failure _ then { return "false" }
    }
}

to describe_table(db: Db, row: {Text: Text}) returns StudioTableInfo {
    let name = row_text(row, "name")
    let kind = nonempty(row_text(row, "type"), "table")
    let sql = row_text(row, "sql")
    if not ident_ok(name) {
        return StudioTableInfo.new(
            name: name,
            kind: kind,
            sql: sql,
            row_count: "0",
            rls_enabled: "false",
            columns: empty_rows(),
            foreign_keys: empty_rows(),
            indexes: empty_rows(),
        )
    }
    return StudioTableInfo.new(
        name: name,
        kind: kind,
        sql: sql,
        row_count: table_count(db, name),
        rls_enabled: rls_flag(db, name),
        columns: table_columns(db, name),
        foreign_keys: table_foreign_keys(db, name),
        indexes: table_indexes(db, name),
    )
}

to list_studio_tables(db: Db) returns [StudioTableInfo] or fails RigError {
    let rows = try catalog_table_rows(db)
    return rows.map(row -> describe_table(db, row))
}

to log_studio(db: Db, service: Text, level: Text, method: Text, path: Text, msg: Text, status_code: Text, duration_ms: Text) returns Int {
    let id = "{service}-{now()}-{msg.length}"
    match db.from("studio_logs").insert({
        "id": id,
        "ts": "{now()}",
        "service": service,
        "level": level,
        "status_code": status_code,
        "method": method,
        "path": path,
        "msg": msg,
        "duration_ms": duration_ms,
    }) {
        when success count then { return count }
        when failure _ then { return 0 }
    }
}

to sql_safe(sql: Text) returns Text or fails RigError {
    if sql.is_empty {
        fail RigError.BadRequest("empty sql")
    }
    let lowered = sql.lower()
    if lowered.contains(";") {
        fail RigError.BadRequest("single statement only")
    }
    if lowered.contains("attach") {
        fail RigError.Unsafe(sql)
    }
    if lowered.contains("detach") {
        fail RigError.Unsafe(sql)
    }
    if lowered.contains("readfile") {
        fail RigError.Unsafe(sql)
    }
    if lowered.contains("writefile") {
        fail RigError.Unsafe(sql)
    }
    if lowered.contains("load_extension") {
        fail RigError.Unsafe(sql)
    }
    if lowered.contains("sqlite_dbpage") {
        fail RigError.Unsafe(sql)
    }
    if lowered.contains("file:") {
        fail RigError.Unsafe(sql)
    }
    return sql
}

to looks_like_read(sql: Text) returns Bool {
    let lowered = sql.lower()
    if lowered.contains("insert into") { return no }
    if lowered.contains("delete from") { return no }
    if lowered.contains("update ") { return no }
    if lowered.contains("create table") { return no }
    if lowered.contains("create index") { return no }
    if lowered.contains("create view") { return no }
    if lowered.contains("create trigger") { return no }
    if lowered.contains("create unique") { return no }
    if lowered.contains("alter table") { return no }
    if lowered.contains("drop table") { return no }
    if lowered.contains("drop index") { return no }
    if lowered.contains("drop view") { return no }
    if lowered.contains("explain") { return yes }
    if lowered.contains("pragma") { return yes }
    if lowered.contains("select") { return yes }
    if lowered.contains("with ") { return yes }
    return no
}

to run_studio_sql(db: Db, sql: Text) returns [{Text: Text}] or fails RigError {
    let safe = try sql_safe(sql)
    let _log = log_studio(db, "postgres", "info", "POST", "/studio-api/sql", safe, "200", "0")
    let empty: [Text] = []
    if looks_like_read(safe) {
        match db.query(safe, empty) {
            when success rows then { return rows }
            when failure error then match error {
                when Failed(message) then { fail RigError.Database(message) }
            }
        }
    }
    match db.execute(safe, empty) {
        when success count then { return [{"count": "{count}"}] }
        when failure error then match error {
            when Failed(message) then { fail RigError.Database(message) }
        }
    }
}

to type_ok(kind: Text) returns Bool {
    if ident_ok(kind) { return yes }
    if kind == "double precision" { return yes }
    if kind == "timestamp with time zone" { return yes }
    return no
}

to default_ok(value: Text) returns Bool {
    if value.is_empty { return yes }
    if value.contains(";") { return no }
    if value.contains("--") { return no }
    return yes
}

to column_sql(col: {Text: Text}) returns Text or fails RigError {
    let name = try ident(row_text(col, "name"))
    let kind = nonempty(row_text(col, "type"), "text")
    if not type_ok(kind) {
        fail RigError.BadRequest("bad column type")
    }
    let changing sql = "{name} {kind}"
    if row_text(col, "pk") == "true" {
        sql = "{sql} primary key"
    }
    if row_text(col, "nullable") == "false" {
        sql = "{sql} not null"
    }
    let dflt = row_text(col, "default")
    if not dflt.is_empty {
        if not default_ok(dflt) {
            fail RigError.BadRequest("bad column default")
        }
        sql = "{sql} default {dflt}"
    }
    let refs = row_text(col, "references")
    if not refs.is_empty {
        if refs.contains(";") {
            fail RigError.BadRequest("bad references")
        }
        sql = "{sql} references {refs}"
    }
    return sql
}

to columns_sql(cols: [{Text: Text}], i: Int) returns Text or fails RigError {
    if i >= cols.count { return "" }
    let piece = try column_sql(cols[i])
    let rest = try columns_sql(cols, i + 1)
    if rest.is_empty { return piece }
    return "{piece}, {rest}"
}

to run_studio_ddl(db: Db, body: StudioDdlBody) returns [{Text: Text}] or fails RigError {
    let table = try ident(body.table)
    if is_sqlite_name(table) {
        fail RigError.Forbidden(table)
    }
    if body.action == "create" {
        let cols = try columns_sql(body.columns, 0)
        if cols.is_empty {
            fail RigError.BadRequest("columns required")
        }
        let _n = try exec_sql(db, "create table {table} ({cols})")
        let _l = log_studio(db, "postgres", "info", "POST", "/studio-api/tables/ddl", "create {table}", "200", "0")
        return [{"count": "1", "table": table}]
    }
    if body.action == "drop" {
        let _n = try exec_sql(db, "drop table if exists {table}")
        let _l = log_studio(db, "postgres", "info", "POST", "/studio-api/tables/ddl", "drop {table}", "200", "0")
        return [{"count": "1", "table": table}]
    }
    if body.action == "truncate" {
        let _n = try exec_sql(db, "delete from {table}")
        let _l = log_studio(db, "postgres", "info", "POST", "/studio-api/tables/ddl", "truncate {table}", "200", "0")
        return [{"count": "1", "table": table}]
    }
    if body.action == "duplicate" {
        let dest = try ident(body.new_name)
        let _n = try exec_sql(db, "create table {dest} as select * from {table}")
        let _l = log_studio(db, "postgres", "info", "POST", "/studio-api/tables/ddl", "duplicate {table}", "200", "0")
        return [{"count": "1", "table": dest}]
    }
    if body.action == "add_column" {
        if body.columns.is_empty {
            fail RigError.BadRequest("columns required")
        }
        let col = try column_sql(body.columns[0])
        let _n = try exec_sql(db, "alter table {table} add column {col}")
        return [{"count": "1", "table": table}]
    }
    if body.action == "rename_column" {
        if body.columns.is_empty {
            fail RigError.BadRequest("columns required")
        }
        let from_name = try ident(row_text(body.columns[0], "name"))
        let to_name = try ident(body.new_name)
        let _n = try exec_sql(db, "alter table {table} rename column {from_name} to {to_name}")
        return [{"count": "1", "table": table}]
    }
    if body.action == "drop_column" {
        if not body.new_name.is_empty {
            let col = try ident(body.new_name)
            let _d = try exec_sql(db, "alter table {table} drop column {col}")
            return [{"count": "1", "table": table}]
        }
        if body.columns.is_empty {
            fail RigError.BadRequest("column name required")
        }
        let named = try ident(row_text(body.columns[0], "name"))
        let _n = try exec_sql(db, "alter table {table} drop column {named}")
        return [{"count": "1", "table": table}]
    }
    if body.action == "rename" {
        let dest = try ident(body.new_name)
        let _n = try exec_sql(db, "alter table {table} rename to {dest}")
        return [{"count": "1", "table": dest}]
    }
    if not body.sql.is_empty {
        return try run_studio_sql(db, body.sql)
    }
    fail RigError.BadRequest("unknown ddl action")
}

to apply_filter(q: Query, filter: {Text: Text}) returns Query {
    let col = row_text(filter, "column")
    if not ident_ok(col) { return q }
    let op = nonempty(row_text(filter, "op"), "=")
    let val = row_text(filter, "value")
    if op == "!=" { return q.differs(col, val) }
    if op == ">" { return q.above(col, val) }
    if op == ">=" { return q.at_least(col, val) }
    if op == "<" { return q.below(col, val) }
    if op == "<=" { return q.at_most(col, val) }
    if op == "LIKE" { return q.like(col, val) }
    if op == "like" { return q.like(col, val) }
    if op == "IS NULL" { return q.equals(col, "") }
    if op == "IS NOT NULL" { return q.differs(col, "") }
    return q.equals(col, val)
}

to apply_filters(q: Query, filters: [{Text: Text}], i: Int) returns Query {
    if i >= filters.count { return q }
    return apply_filters(apply_filter(q, filters[i]), filters, i + 1)
}

to apply_sort(q: Query, sort: {Text: Text}) returns Query {
    let col = row_text(sort, "column")
    if not ident_ok(col) { return q }
    let dir = row_text(sort, "dir").lower()
    if dir == "asc" { return q.order(col) }
    return q.order_desc(col)
}

to apply_sorts(q: Query, sorts: [{Text: Text}], i: Int) returns Query {
    if i >= sorts.count { return q }
    return apply_sorts(apply_sort(q, sorts[i]), sorts, i + 1)
}

to clamp_limit(n: Int) returns Int {
    if n <= 0 { return 100 }
    if n > 1000 { return 1000 }
    return n
}

to policy_role_ok(roles: Text, role: Text) returns Bool {
    let lowered = roles.lower()
    if lowered.is_empty { return yes }
    if lowered == "public" { return yes }
    if lowered.contains(role) { return yes }
    return no
}

to policy_command_ok(command_name: Text, command: Text) returns Bool {
    let lowered = command_name.lower()
    if lowered.is_empty { return yes }
    if lowered == "all" { return yes }
    if lowered == "*" { return yes }
    if lowered == command { return yes }
    return no
}

to rls_enforced(db: Db, table_name: Text) returns Bool {
    let flag = rls_flag(db, table_name)
    if flag == "true" { return yes }
    if flag == "1" { return yes }
    match db.from("studio_policies").equals("table_name", table_name).count() {
        when success n then { return n > 0 }
        when failure _ then { return no }
    }
}

to uid_column(db: Db, definition: Text) returns Text or fails RigError {
    if not definition.lower().contains("auth.uid()") { return "" }
    let rows = try query_args(db, "select trim(replace(replace(replace(lower(?1), 'auth.uid()', ''), '=', ''), ' ', '')) as r", [definition])
    if rows.is_empty { return "" }
    let column = rows[0].get("r") otherwise ""
    if ident_ok(column) { return column }
    return ""
}

to fold_policies(db: Db, rows: [{Text: Text}], command: Text, role: Text, i: Int, kind: Text, column: Text) returns RlsMode or fails RigError {
    if i >= rows.count {
        return RlsMode.new(kind: kind, column: column)
    }
    let row = rows[i]
    let action = row_text(row, "action").lower()
    if action == "restrictive" {
        return try fold_policies(db, rows, command, role, i + 1, kind, column)
    }
    if not policy_command_ok(row_text(row, "command"), command) {
        return try fold_policies(db, rows, command, role, i + 1, kind, column)
    }
    if not policy_role_ok(row_text(row, "roles"), role) {
        return try fold_policies(db, rows, command, role, i + 1, kind, column)
    }
    let definition = row_text(row, "definition").lower()
    if definition == "true" or definition == "(true)" {
        return RlsMode.new(kind: "open", column: "")
    }
    let column_name = try uid_column(db, definition)
    if not column_name.is_empty {
        if kind == "uid" and column != column_name {
            return try fold_policies(db, rows, command, role, i + 1, kind, column)
        }
        return try fold_policies(db, rows, command, role, i + 1, "uid", column_name)
    }
    return try fold_policies(db, rows, command, role, i + 1, kind, column)
}

to rls_mode(db: Db, table_name: Text, command: Text, actor: Actor) returns RlsMode or fails RigError {
    if actor.role == "postgres" {
        return RlsMode.new(kind: "open", column: "")
    }
    if not rls_enforced(db, table_name) {
        return RlsMode.new(kind: "open", column: "")
    }
    match db.from("studio_policies").equals("table_name", table_name).all() {
        when success rows then { return try fold_policies(db, rows, command, actor.role, 0, "deny", "") }
        when failure error then match error {
            when Failed(message) then { fail RigError.Database(message) }
        }
    }
}

to query_studio_rows(db: Db, body: StudioRowQuery, actor: Actor) returns StudioRowPage or fails RigError {
    let table = try allow_user_table(body.table)
    let mode = try rls_mode(db, table, "select", actor)
    if mode.kind == "deny" or (mode.kind == "uid" and actor.uid.is_empty) {
        return StudioRowPage.new(rows: empty_rows(), count: 0)
    }
    let base = if mode.kind == "uid" { db.from(table).equals(mode.column, actor.uid) } else { db.from(table) }
    let filtered = apply_filters(base, body.filters, 0)
    match filtered.count() {
        when success total then {
            let sorted = apply_sorts(filtered, body.sorts, 0)
            let pk = primary_key(db, table)
            let ordered = if body.sorts.is_empty { sorted.order_desc(pk) } else { sorted }
            match ordered.limit(clamp_limit(body.limit)).offset(body.offset.max(0)).all() {
                when success rows then { return StudioRowPage.new(rows: rows, count: total) }
                when failure error then match error {
                    when Failed(message) then { fail RigError.Database(message) }
                }
            }
        }
        when failure error then match error {
            when Failed(message) then { fail RigError.Database(message) }
        }
    }
}

to assert_values(db: Db, table: Text, command: Text, actor: Actor, values: {Text: Text}, strict: Bool) returns Int or fails RigError {
    let mode = try rls_mode(db, table, command, actor)
    if mode.kind == "open" { return 1 }
    if mode.kind == "uid" and not actor.uid.is_empty {
        match values.get(mode.column) {
            when found value then {
                if value == actor.uid { return 1 }
            }
            when nothing then {
                if not strict { return 1 }
            }
        }
    }
    fail RigError.Forbidden(table)
}

to assert_existing(db: Db, table: Text, command: Text, actor: Actor, id: Text) returns Int or fails RigError {
    let mode = try rls_mode(db, table, command, actor)
    if mode.kind == "open" { return 1 }
    if mode.kind == "uid" and not actor.uid.is_empty {
        let row = try get(db, table, id)
        let value = row.get(mode.column) otherwise ""
        if value == actor.uid { return 1 }
    }
    fail RigError.Forbidden(table)
}

to insert_studio_values(db: Db, body: StudioRowWrite, actor: Actor) returns Int or fails RigError {
    let table = try allow_user_table(body.table)
    if body.values.is_empty {
        fail RigError.BadRequest("values required")
    }
    if not values_ok(body.values) {
        fail RigError.BadRequest("bad column name")
    }
    let _ok = try assert_values(db, table, "insert", actor, body.values, yes)
    match db.from(table).insert(body.values) {
        when success count then { return count }
        when failure error then match error {
            when Failed(message) then { fail RigError.Database(message) }
        }
    }
}

to patch_studio_values(db: Db, body: StudioRowWrite, actor: Actor) returns Int or fails RigError {
    let table = try allow_user_table(body.table)
    if body.id.is_empty {
        fail RigError.BadRequest("id required")
    }
    if body.values.is_empty {
        fail RigError.BadRequest("values required")
    }
    if not values_ok(body.values) {
        fail RigError.BadRequest("bad column name")
    }
    let _existing = try assert_existing(db, table, "update", actor, body.id)
    let _next = try assert_values(db, table, "update", actor, body.values, no)
    let pk = primary_key(db, table)
    match db.from(table).equals(pk, body.id).update(body.values) {
        when success count then {
            if count == 0 { fail RigError.NotFound(body.id) }
            return count
        }
        when failure error then match error {
            when Failed(message) then { fail RigError.Database(message) }
        }
    }
}

to delete_one_id(db: Db, table: Text, pk: Text, id: Text, actor: Actor) returns Int or fails RigError {
    let _ok = try assert_existing(db, table, "delete", actor, id)
    match db.from(table).equals(pk, id).delete() {
        when success count then { return count }
        when failure error then match error {
            when Failed(message) then { fail RigError.Database(message) }
        }
    }
}

to delete_studio_ids_at(db: Db, table: Text, pk: Text, ids: [Text], actor: Actor, i: Int) returns Int or fails RigError {
    if i >= ids.count { return 0 }
    let n = try delete_one_id(db, table, pk, ids[i], actor)
    return n + try delete_studio_ids_at(db, table, pk, ids, actor, i + 1)
}

to delete_studio_ids(db: Db, body: StudioRowDelete, actor: Actor) returns Int or fails RigError {
    let table = try allow_user_table(body.table)
    let pk = primary_key(db, table)
    return try delete_studio_ids_at(db, table, pk, body.ids, actor, 0)
}

to list_snippets(db: Db) returns [{Text: Text}] or fails RigError {
    match db.from("studio_snippets").order_desc("updated_at").all() {
        when success rows then { return rows }
        when failure error then match error {
            when Failed(message) then { fail RigError.Database(message) }
        }
    }
}

to save_snippet(db: Db, body: StudioSnippetBody) returns Int or fails RigError {
    let id = nonempty(body.id, "snip-{now()}")
    match db.from("studio_snippets").equals("id", id).first() {
        when success maybe then match maybe {
            when found _ then match db.from("studio_snippets").equals("id", id).update({
                "name": body.name,
                "description": body.description,
                "sql": body.sql,
                "folder": nonempty(body.folder, "Private"),
                "favorite": nonempty(body.favorite, "false"),
                "visibility": nonempty(body.visibility, "private"),
                "updated_at": "{now()}",
            }) {
                when success count then { return count }
                when failure error then match error {
                    when Failed(message) then { fail RigError.Database(message) }
                }
            }
            when nothing then match db.from("studio_snippets").insert({
                "id": id,
                "name": body.name,
                "description": body.description,
                "sql": body.sql,
                "folder": nonempty(body.folder, "Private"),
                "favorite": nonempty(body.favorite, "false"),
                "visibility": nonempty(body.visibility, "private"),
                "updated_at": "{now()}",
            }) {
                when success count then { return count }
                when failure error then match error {
                    when Failed(message) then { fail RigError.Database(message) }
                }
            }
        }
        when failure error then match error {
            when Failed(message) then { fail RigError.Database(message) }
        }
    }
}

to delete_snippet(db: Db, body: StudioSnippetBody) returns Int or fails RigError {
    if body.id.is_empty {
        fail RigError.BadRequest("id required")
    }
    match db.from("studio_snippets").equals("id", body.id).delete() {
        when success count then { return count }
        when failure error then match error {
            when Failed(message) then { fail RigError.Database(message) }
        }
    }
}

to list_auth_users(db: Db) returns [{Text: Text}] or fails RigError {
    match db.from("auth_users").order_desc("created_at").all() {
        when success rows then { return rows }
        when failure error then match error {
            when Failed(message) then { fail RigError.Database(message) }
        }
    }
}

to save_auth_user(db: Db, body: StudioAuthUserBody) returns Int or fails RigError {
    let id = nonempty(body.id, nonempty(body.email, "user-{now()}"))
    if id.is_empty {
        fail RigError.BadRequest("id or email required")
    }
    if body.action == "invite" {
        fail RigError.BadRequest("invite is not mounted")
    }
    if body.action == "create" or body.action == "reset_password" {
        if body.password.is_empty {
            fail RigError.BadRequest("password required")
        }
    }
    if body.action == "ban" {
        match db.from("auth_users").equals("id", id).update({"banned_until": nonempty(body.banned_until, "{now()}")}) {
            when success count then { return count }
            when failure error then match error {
                when Failed(message) then { fail RigError.Database(message) }
            }
        }
    }
    if body.action == "unban" {
        match db.from("auth_users").equals("id", id).update({"banned_until": ""}) {
            when success count then { return count }
            when failure error then match error {
                when Failed(message) then { fail RigError.Database(message) }
            }
        }
    }
    match db.from("auth_users").equals("id", id).first() {
        when success maybe then match maybe {
            when found _ then match db.from("auth_users").equals("id", id).update({
                "email": body.email,
                "phone": body.phone,
                "provider": nonempty(body.provider, "email"),
                "raw_user_meta_data": nonempty(body.raw_user_meta_data, ""),
                "banned_until": body.banned_until,
            }) {
                when success count then {
                    let _p = try store_password(db, id, body.password)
                    return count + _p - _p
                }
                when failure error then match error {
                    when Failed(message) then { fail RigError.Database(message) }
                }
            }
            when nothing then {
                match db.from("auth_users").insert({
                    "id": id,
                    "email": body.email,
                    "phone": body.phone,
                    "provider": nonempty(body.provider, "email"),
                    "created_at": "{now()}",
                    "last_sign_in_at": "",
                    "raw_user_meta_data": nonempty(body.raw_user_meta_data, ""),
                    "banned_until": body.banned_until,
                }) {
                    when success count then {
                        match db.from("profiles").equals("id", id).first() {
                            when success existing then match existing {
                                when found _ then {
                                    let _p = try store_password(db, id, body.password)
                                    return count
                                }
                                when nothing then match db.from("profiles").insert({"id": id, "email": body.email, "name": ""}) {
                                    when success _ then {
                                        let _p = try store_password(db, id, body.password)
                                        return count
                                    }
                                    when failure _ then {
                                        let _p = try store_password(db, id, body.password)
                                        return count
                                    }
                                }
                            }
                            when failure _ then {
                                let _p = try store_password(db, id, body.password)
                                return count
                            }
                        }
                    }
                    when failure error then match error {
                        when Failed(message) then { fail RigError.Database(message) }
                    }
                }
            }
        }
        when failure error then match error {
            when Failed(message) then { fail RigError.Database(message) }
        }
    }
}

