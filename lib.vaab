    route post "/rows/insert" expecting StudioRowWrite as body {
        match authorize_studio(default_studio(), request.headers) {
            when success _ then match RigRoutes.studio_row_insert(body, studio_actor(request.headers)) {
                when success count then { reply with count status 201 }
                when failure error then {
                    reply text explain(error) as "text/plain; charset=utf-8" status 400
                }
            }
            when failure _ then {
                reply text "unauthorized" as "text/plain" status 401
            }
        }
    }

    route post "/rows/update" expecting StudioRowWrite as body {
        match authorize_studio(default_studio(), request.headers) {
            when success _ then match RigRoutes.studio_row_patch(body, studio_actor(request.headers)) {
                when success count then { reply with count }
                when failure error then {
                    reply text explain(error) as "text/plain; charset=utf-8" status 400
                }
            }
            when failure _ then {
                reply text "unauthorized" as "text/plain" status 401
            }
