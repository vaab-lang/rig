to save_function(db: Db, body: StudioFunctionBody) returns StudioFunctionResult or fails RigError {
    if body.invoke == "true" {
        let started = now()
        let _l = log_studio(db, "edge-functions", "info", nonempty(body.method, "POST"), "/functions/v1/{body.slug}", body.body, "200", "1")
        let elapsed = now() - started
        return StudioFunctionResult.new(count: 0, invoked: yes, status: "200", body: "ok {body.slug}", duration_ms: "{elapsed}")
    }
    let id = nonempty(body.id, nonempty(body.slug, "fn-{now()}"))
    match db.from("studio_functions").equals("id", id).first() {
        when success maybe then match maybe {
            when found _ then match db.from("studio_functions").equals("id", id).update({
                "slug": nonempty(body.slug, id),
                "name": nonempty(body.name, body.slug),
                "status": nonempty(body.status, "active"),
                "version": nonempty(body.version, "1"),
                "entrypoint_path": nonempty(body.entrypoint_path, "index.ts"),
                "verify_jwt": nonempty(body.verify_jwt, "true"),
                "code": body.code,
                "updated_at": "{now()}",
            }) {
                when success count then {
                    return StudioFunctionResult.new(count: count, invoked: no, status: "", body: "", duration_ms: "0")
                }
                when failure error then match error {
                    when Failed(message) then { fail RigError.Database(message) }
                }
            }
            when nothing then match db.from("studio_functions").insert({
                "id": id,
                "slug": nonempty(body.slug, id),
                "name": nonempty(body.name, body.slug),
                "status": nonempty(body.status, "active"),
                "version": nonempty(body.version, "1"),
                "entrypoint_path": nonempty(body.entrypoint_path, "index.ts"),
                "verify_jwt": nonempty(body.verify_jwt, "true"),
                "code": body.code,
                "created_at": "{now()}",
                "updated_at": "{now()}",
            }) {
                when success count then {
                    return StudioFunctionResult.new(count: count, invoked: no, status: "", body: "", duration_ms: "0")
                }
                when failure error then match error {
                    when Failed(message) then { fail RigError.Database(message) }
                }
            }
        }
        when failure error then match error {
            when Failed(message) then { fail RigError.Database(message) }
        }
    }
}

