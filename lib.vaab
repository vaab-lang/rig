    route post "/rows/query" expecting StudioRowQuery as body {
        match authorize_studio(default_studio(), request.headers) {
            when success _ then match RigRoutes.studio_row_query(body, studio_actor(request.headers)) {
                when success page then { reply with page }
                when failure error then {
