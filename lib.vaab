to query_studio_logs(db: Db, body: StudioLogQuery) returns [{Text: Text}] or fails RigError {
    if not body.sql.is_empty {
        return try run_studio_sql(db, body.sql)
    }
    let changing q = db.from("studio_logs")
    if not body.service.is_empty {
        q = q.equals("service", body.service)
    }
    if not body.level.is_empty {
        q = q.equals("level", body.level)
    }
    match q.order_desc("ts").limit(200).all() {
        when success rows then { return rows }
        when failure error then match error {
            when Failed(message) then { fail RigError.Database(message) }
        }
    }
}

to has_pk(cols: [{Text: Text}], i: Int) returns Bool {
    if i >= cols.count { return no }
    if row_text(cols[i], "pk") == "1" { return yes }
    return has_pk(cols, i + 1)
}

to has_policy(db: Db, table_name: Text) returns Bool {
    match db.from("studio_policies").equals("table_name", table_name).count() {
        when success n then {
            if n > 0 { return yes }
            return no
        }
        when failure _ then { return no }
    }
}

to index_has_column(db: Db, index_name: Text, column: Text) returns Bool {
    if not ident_ok(index_name) { return no }
    let info = pragma_rows(db, "PRAGMA index_info({index_name})")
    return rows_have_name(info, column, 0)
}

to rows_have_name(rows: [{Text: Text}], name: Text, i: Int) returns Bool {
    if i >= rows.count { return no }
    if row_text(rows[i], "name") == name { return yes }
    return rows_have_name(rows, name, i + 1)
}

to indexes_cover(db: Db, indexes: [{Text: Text}], column: Text, i: Int) returns Bool {
    if i >= indexes.count { return no }
    if index_has_column(db, row_text(indexes[i], "name"), column) { return yes }
    return indexes_cover(db, indexes, column, i + 1)
}

to write_fk_lints(db: Db, table_name: Text, fks: [{Text: Text}], indexes: [{Text: Text}], i: Int) {
    if i >= fks.count { return }
    let col = row_text(fks[i], "from")
    if not col.is_empty {
        if not indexes_cover(db, indexes, col, 0) {
            let _n = log_studio(db, "advisor", "WARN", "GET", "/studio-api/advisors", "unindexed foreign key {table_name}.{col}", "", "0")
        }
    }
    write_fk_lints(db, table_name, fks, indexes, i + 1)
}

to write_table_lints(db: Db, row: {Text: Text}) {
    let name = row_text(row, "name")
    if not ident_ok(name) { return }
    if is_sqlite_name(name) { return }
    let kind = row_text(row, "type")
    if kind == "view" {
        let _v = log_studio(db, "advisor", "INFO", "GET", "/studio-api/advisors", "exposed view {name}", "", "0")
        return
    }
    let columns = table_columns(db, name)
    if not has_pk(columns, 0) {
        let _p = log_studio(db, "advisor", "ERROR", "GET", "/studio-api/advisors", "table missing primary key {name}", "", "0")
    }
    if not has_policy(db, name) {
        if rls_flag(db, name) == "false" {
            let _r = log_studio(db, "advisor", "WARN", "GET", "/studio-api/advisors", "table without RLS policies {name}", "", "0")
        }
    }
    write_fk_lints(db, name, table_foreign_keys(db, name), table_indexes(db, name), 0)
}

to list_advisors(db: Db) returns [{Text: Text}] or fails RigError {
    let _c = try exec_sql(db, "delete from studio_logs where service = 'advisor'")
    let tables = try catalog_table_rows(db)
    tables.each(row -> write_table_lints(db, row))
    match db.from("studio_logs").equals("service", "advisor").order_desc("id").all() {
        when success rows then { return rows }
        when failure error then match error {
            when Failed(message) then { fail RigError.Database(message) }
