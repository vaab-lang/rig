# --- health ----------------------------------------------------------------

to health() returns Health {
    return Health.new(name: "rig", ok: yes, version: "0.1.0")
}

to auth_health() returns Health {
    return Health.new(name: "rig-auth", ok: yes, version: "0.1.0")
}

to registry_health() returns RegistryHealth {
    return RegistryHealth.new(ok: yes, service: "riff")
}

to catalog_web_root() returns Text {
    match env.get("RIG_CATALOG_WEB_ROOT") {
        when found root then { return root }
        when nothing then { return "web/dist" }
    }
}

to resolve_catalog(requested: Text) returns Text or fails RigError {
    if requested.contains("..") {
        fail RigError.Unsafe(requested)
    }
    let root = catalog_web_root()
    if requested.is_empty {
        return "{root}/index.html"
    }
    if requested.contains(".") {
        return "{root}/{requested}"
    }
    return "{root}/index.html"
}

to explain(error: RigError) returns Text {
    match error {
        when Missing(name) then { return "missing {name}" }
        when Database(message) then { return message }
        when Unauthorized then { return "unauthorized" }
        when BadRequest(message) then { return message }
        when NotFound(resource) then { return "not found: {resource}" }
        when Forbidden(table) then { return "forbidden {table}" }
        when Unsafe(requested) then { return "unsafe {requested}" }
    }
}

to http_status(error: RigError) returns Int {
    match error {
        when Unauthorized then { return 401 }
        when Forbidden(_) then { return 403 }
        when NotFound(_) then { return 404 }
        when BadRequest(_) then { return 400 }
        when Missing(_) then { return 500 }
        when Database(_) then { return 400 }
        when Unsafe(_) then { return 400 }
    }
}

# SHA-256 over UTF-8, using SQLite for 32-bit bitwise ops (Vaab has none).

to sql_text(db: Db, sql: Text, args: [Text]) returns Text or fails DbError {
    let rows = try db.query(sql, args)
    if rows.is_empty {
        fail DbError.Failed("empty")
    }
    return rows[0].get("r") otherwise ""
}

to sql_int(db: Db, sql: Text, args: [Text]) returns Int or fails DbError {
    let text = try sql_text(db, sql, args)
    match from_json(text, as: Int) {
        when success n then { return n }
        when failure _ then { fail DbError.Failed("bad int {text}") }
    }
}

to rotr(db: Db, x: Int, n: Int) returns Int or fails DbError {
    return try sql_int(db, "select (((?1 >> ?2) | ((?1 << (32 - ?2)) & 4294967295)) & 4294967295) as r", ["{x}", "{n}"])
}

to shr(db: Db, x: Int, n: Int) returns Int or fails DbError {
    return try sql_int(db, "select (?1 >> ?2) as r", ["{x}", "{n}"])
}

to xor2(db: Db, a: Int, b: Int) returns Int or fails DbError {
    return try sql_int(db, "select (((?1 | ?2) - (?1 & ?2)) & 4294967295) as r", ["{a}", "{b}"])
}

to band(db: Db, a: Int, b: Int) returns Int or fails DbError {
    return try sql_int(db, "select (?1 & ?2) as r", ["{a}", "{b}"])
}

to add32(db: Db, a: Int, b: Int) returns Int or fails DbError {
    return try sql_int(db, "select ((?1 + ?2) & 4294967295) as r", ["{a}", "{b}"])
}

to xor3(db: Db, a: Int, b: Int, c: Int) returns Int or fails DbError {
    let ab = try xor2(db, a, b)
    return try xor2(db, ab, c)
}

to ch(db: Db, e: Int, f: Int, g: Int) returns Int or fails DbError {
    let ef = try band(db, e, f)
    let not_e = 4294967295 - e
    let ng = try band(db, not_e, g)
    return try xor2(db, ef, ng)
}

to maj(db: Db, a: Int, b: Int, c: Int) returns Int or fails DbError {
    let ab = try band(db, a, b)
    let ac = try band(db, a, c)
    let bc = try band(db, b, c)
    return try xor3(db, ab, ac, bc)
}

to byte_at(db: Db, i: Int) returns Int or fails DbError {
    return try sql_int(db, "select v as r from m where i = ?1", ["{i}"])
}

to wget(db: Db, i: Int) returns Int or fails DbError {
    return try sql_int(db, "select v as r from w where i = ?1", ["{i}"])
}

to kget(db: Db, i: Int) returns Int or fails DbError {
    return try sql_int(db, "select v as r from k where i = ?1", ["{i}"])
}

to put_w(db: Db, i: Int, v: Int) returns Int or fails DbError {
    return try db.execute("insert into w(i, v) values (?1, ?2)", ["{i}", "{v}"])
}

to put_m(db: Db, i: Int, v: Int) returns Int or fails DbError {
    return try db.execute("insert into m(i, v) values (?1, ?2)", ["{i}", "{v}"])
}

to sha256_hex(message: Text, raw_hex: Bool) returns Text or fails DbError {
    let db = try Db.connect("sqlite::memory:")
    let empty: [Text] = []
    let _t1 = try db.execute("create table m(i integer primary key, v integer)", empty)
    let _t2 = try db.execute("create table w(i integer primary key, v integer)", empty)
    let _t3 = try db.execute("create table k(i integer primary key, v integer)", empty)
    let _k = try db.execute("insert into k(i, v) values (0,1116352408),(1,1899447441),(2,3049323471),(3,3921009573),(4,961987163),(5,1508970993),(6,2453635748),(7,2870763221),(8,3624381080),(9,310598401),(10,607225278),(11,1426881987),(12,1925078388),(13,2162078206),(14,2614888103),(15,3248222580),(16,3835390401),(17,4022224774),(18,264347078),(19,604807628),(20,770255983),(21,1249150122),(22,1555081692),(23,1996064986),(24,2554220882),(25,2821834349),(26,2952996808),(27,3210313671),(28,3336571891),(29,3584528711),(30,113926993),(31,338241895),(32,666307205),(33,773529912),(34,1294757372),(35,1396182291),(36,1695183700),(37,1986661051),(38,2177026350),(39,2456956037),(40,2730485921),(41,2820302411),(42,3259730800),(43,3345764771),(44,3516065817),(45,3600352804),(46,4094571909),(47,275423344),(48,430227734),(49,506948616),(50,659060556),(51,883997877),(52,958139571),(53,1322822218),(54,1537002063),(55,1747873779),(56,1955562222),(57,2024104815),(58,2227730452),(59,2361852424),(60,2428436474),(61,2756734187),(62,3204031479),(63,3329325298)", empty)
    let load_text = "insert into m(i, v) with recursive src(h) as (select hex(?1)), bytes(i, v) as (select 0, (instr('0123456789ABCDEF', substr(h, 1, 1)) - 1) * 16 + (instr('0123456789ABCDEF', substr(h, 2, 1)) - 1) from src where length(h) >= 2 union all select i + 1, (instr('0123456789ABCDEF', substr((select h from src), (i + 1) * 2 + 1, 1)) - 1) * 16 + (instr('0123456789ABCDEF', substr((select h from src), (i + 1) * 2 + 2, 1)) - 1) from bytes where (i + 1) * 2 < (select length(h) from src)) select i, v from bytes"
    let load_hex = "insert into m(i, v) with recursive src(h) as (select upper(?1)), bytes(i, v) as (select 0, (instr('0123456789ABCDEF', substr(h, 1, 1)) - 1) * 16 + (instr('0123456789ABCDEF', substr(h, 2, 1)) - 1) from src where length(h) >= 2 union all select i + 1, (instr('0123456789ABCDEF', substr((select h from src), (i + 1) * 2 + 1, 1)) - 1) * 16 + (instr('0123456789ABCDEF', substr((select h from src), (i + 1) * 2 + 2, 1)) - 1) from bytes where (i + 1) * 2 < (select length(h) from src)) select i, v from bytes"
    let load = if raw_hex { load_hex } else { load_text }
    let _load = try db.execute(load, [message])
    let n = try sql_int(db, "select count(*) as r from m", empty)
    let bitlen = n * 8
    let _pad = try put_m(db, n, 128)
    let changing len = n + 1
    while len % 64 != 56 {
        let _z = try put_m(db, len, 0)
        len = len + 1
    }
    let hi = bitlen / 4294967296
    let lo = bitlen % 4294967296
    let _a = try put_m(db, len, hi / 16777216)
    let _b = try put_m(db, len + 1, (hi / 65536) % 256)
    let _c = try put_m(db, len + 2, (hi / 256) % 256)
    let _d = try put_m(db, len + 3, hi % 256)
    let _e = try put_m(db, len + 4, lo / 16777216)
    let _f = try put_m(db, len + 5, (lo / 65536) % 256)
    let _g = try put_m(db, len + 6, (lo / 256) % 256)
    let _h = try put_m(db, len + 7, lo % 256)
    len = len + 8
    let blocks = len / 64
    let changing h0 = 1779033703
    let changing h1 = 3144134277
    let changing h2 = 1013904242
    let changing h3 = 2773480762
    let changing h4 = 1359893119
    let changing h5 = 2600822924
    let changing h6 = 528734635
    let changing h7 = 1541459225
    let changing block = 0
    let changing i = 0
    let changing b0 = 0
    let changing b1 = 0
    let changing b2 = 0
    let changing b3 = 0
    let changing word = 0
    let changing s0 = 0
    let changing s1 = 0
    let changing w15 = 0
    let changing w2 = 0
    let changing w16 = 0
    let changing w7 = 0
    let changing a = 0
    let changing b = 0
    let changing c = 0
    let changing d = 0
    let changing e = 0
    let changing f = 0
    let changing g = 0
    let changing h = 0
    let changing r = 0
    let changing kval = 0
    let changing wval = 0
    let changing chv = 0
    let changing majv = 0
    let changing t1 = 0
    let changing t2 = 0
    let changing base = 0
    while block < blocks {
        let _clr = try db.execute("delete from w", empty)
        i = 0
        while i < 16 {
            base = block * 64 + i * 4
            b0 = try byte_at(db, base)
            b1 = try byte_at(db, base + 1)
            b2 = try byte_at(db, base + 2)
            b3 = try byte_at(db, base + 3)
            word = b0 * 16777216 + b1 * 65536 + b2 * 256 + b3
            let _pw = try put_w(db, i, word)
            i = i + 1
        }
        while i < 64 {
            w15 = try wget(db, i - 15)
            w2 = try wget(db, i - 2)
            w16 = try wget(db, i - 16)
            w7 = try wget(db, i - 7)
            s0 = try xor3(db, try rotr(db, w15, 7), try rotr(db, w15, 18), try shr(db, w15, 3))
            s1 = try xor3(db, try rotr(db, w2, 17), try rotr(db, w2, 19), try shr(db, w2, 10))
            word = try add32(db, try add32(db, try add32(db, w16, s0), w7), s1)
            let _pw2 = try put_w(db, i, word)
            i = i + 1
        }
        a = h0
        b = h1
        c = h2
        d = h3
        e = h4
        f = h5
        g = h6
        h = h7
        r = 0
        while r < 64 {
            kval = try kget(db, r)
            wval = try wget(db, r)
            s1 = try xor3(db, try rotr(db, e, 6), try rotr(db, e, 11), try rotr(db, e, 25))
            chv = try ch(db, e, f, g)
            t1 = try add32(db, try add32(db, try add32(db, try add32(db, h, s1), chv), kval), wval)
            s0 = try xor3(db, try rotr(db, a, 2), try rotr(db, a, 13), try rotr(db, a, 22))
            majv = try maj(db, a, b, c)
            t2 = try add32(db, s0, majv)
            h = g
            g = f
            f = e
            e = try add32(db, d, t1)
            d = c
            c = b
            b = a
            a = try add32(db, t1, t2)
            r = r + 1
        }
        h0 = try add32(db, h0, a)
        h1 = try add32(db, h1, b)
        h2 = try add32(db, h2, c)
        h3 = try add32(db, h3, d)
        h4 = try add32(db, h4, e)
        h5 = try add32(db, h5, f)
        h6 = try add32(db, h6, g)
        h7 = try add32(db, h7, h)
        block = block + 1
    }
    let p0 = try sql_text(db, "select printf('%08x', ?1) as r", ["{h0}"])
    let p1 = try sql_text(db, "select printf('%08x', ?1) as r", ["{h1}"])
    let p2 = try sql_text(db, "select printf('%08x', ?1) as r", ["{h2}"])
    let p3 = try sql_text(db, "select printf('%08x', ?1) as r", ["{h3}"])
    let p4 = try sql_text(db, "select printf('%08x', ?1) as r", ["{h4}"])
    let p5 = try sql_text(db, "select printf('%08x', ?1) as r", ["{h5}"])
    let p6 = try sql_text(db, "select printf('%08x', ?1) as r", ["{h6}"])
    let p7 = try sql_text(db, "select printf('%08x', ?1) as r", ["{h7}"])
    return "{p0}{p1}{p2}{p3}{p4}{p5}{p6}{p7}"
}

to hex_of(db: Db, text: Text) returns Text or fails DbError {
    return try sql_text(db, "select hex(?1) as r", [text])
}

to xor_byte(db: Db, a: Int, b: Int) returns Int or fails DbError {
    return try sql_int(db, "select ((?1 | ?2) - (?1 & ?2)) as r", ["{a}", "{b}"])
}

to hmac_sha256_hex(key: Text, message: Text) returns Text or fails DbError {
    let db = try Db.connect("sqlite::memory:")
    let empty: [Text] = []
    let _t = try db.execute("create table kb(i integer primary key, v integer)", empty)
    let load = "insert into kb(i, v) with recursive src(h) as (select hex(?1)), bytes(i, v) as (select 0, (instr('0123456789ABCDEF', substr(h, 1, 1)) - 1) * 16 + (instr('0123456789ABCDEF', substr(h, 2, 1)) - 1) from src where length(h) >= 2 union all select i + 1, (instr('0123456789ABCDEF', substr((select h from src), (i + 1) * 2 + 1, 1)) - 1) * 16 + (instr('0123456789ABCDEF', substr((select h from src), (i + 1) * 2 + 2, 1)) - 1) from bytes where (i + 1) * 2 < (select length(h) from src)) select i, v from bytes"
    let _load = try db.execute(load, [key])
    let key_len = try sql_int(db, "select count(*) as r from kb", empty)
    let changing key_hex = ""
    if key_len > 64 {
        key_hex = try sha256_hex(key, no)
    }
    let changing i = 0
    let changing ipad = ""
    let changing opad = ""
    let changing byte = 0
    let changing ib = 0
    let changing ob = 0
    let changing pair = ""
    while i < 64 {
        byte = 0
        if key_len > 64 {
            if i < 32 {
                pair = try sql_text(db, "select substr(?1, ?2, 2) as r", [key_hex, "{i * 2 + 1}"])
                byte = try sql_int(db, "select ((instr('0123456789abcdef', substr(lower(?1), 1, 1)) - 1) * 16 + (instr('0123456789abcdef', substr(lower(?1), 2, 1)) - 1)) as r", [pair])
            }
        } else if i < key_len {
            byte = try sql_int(db, "select v as r from kb where i = ?1", ["{i}"])
        }
        ib = try xor_byte(db, byte, 54)
        ob = try xor_byte(db, byte, 92)
        let ih = try sql_text(db, "select printf('%02x', ?1) as r", ["{ib}"])
        let oh = try sql_text(db, "select printf('%02x', ?1) as r", ["{ob}"])
        ipad = "{ipad}{ih}"
        opad = "{opad}{oh}"
        i = i + 1
    }
    let message_hex = try hex_of(db, message)
    let inner = try sha256_hex("{ipad}{message_hex}", yes)
    return try sha256_hex("{opad}{inner}", yes)
}

# --- passwords and JWT (HS256 via HMAC-SHA256) ---------------------------

to lift_db(error: DbError) returns RigError {
    match error {
        when Failed(message) then { return RigError.Database(message) }
    }
}

to digest_text(message: Text) returns Text or fails RigError {
    match sha256_hex(message, no) {
        when success value then { return value }
        when failure error then { fail lift_db(error) }
    }
}

to mac_hex(key: Text, message: Text) returns Text or fails RigError {
    match hmac_sha256_hex(key, message) {
        when success value then { return value }
        when failure error then { fail lift_db(error) }
    }
}

to memory_db() returns Db or fails RigError {
    match Db.connect("sqlite::memory:") {
        when success db then { return db }
        when failure error then match error {
            when Failed(message) then { fail RigError.Database(message) }
        }
    }
}

to auth_secret() returns Text or fails RigError {
    match env.get("AUTH_SECRET") {
        when found value then {
            if value.is_empty { fail RigError.Missing("AUTH_SECRET") }
            return value
        }
        when nothing then { fail RigError.Missing("AUTH_SECRET") }
    }
}

to anon_key() returns Text {
    return env.get("RIG_ANON_KEY") otherwise "rig-anon-key"
}

to header_get(headers: {Text: Text}, name: Text) returns Text {
    match headers.get(name) {
        when found value then { return value }
        when nothing then { return "" }
    }
}

to bearer_token(header: Text) returns Text or fails RigError {
    if header.is_empty { return "" }
    let db = try memory_db()
    let rows = try query_args(db, "select case when lower(substr(?1, 1, 7)) = 'bearer ' then trim(substr(?1, 8)) else '' end as r", [header])
    if rows.is_empty { return "" }
    return rows[0].get("r") otherwise ""
}

to b64url_hex(hex: Text) returns Text or fails RigError {
    match Bytes.from_hex(hex) {
        when success raw then {
            let db = try memory_db()
            let rows = try query_args(db, "select replace(replace(rtrim(?1, '='), '+', '-'), '/', '_') as r", [raw.to_base64()])
            if rows.is_empty { return "" }
            return rows[0].get("r") otherwise ""
        }
        when failure _ then { fail RigError.BadRequest("bad hex") }
    }
}

to b64url_text(text: Text) returns Text or fails RigError {
    let db = try memory_db()
    let rows = try query_args(db, "select hex(?1) as r", [text])
    if rows.is_empty { fail RigError.BadRequest("empty text") }
    return try b64url_hex(rows[0].get("r") otherwise "")
}

to b64url_decode(text: Text) returns Text or fails RigError {
    let db = try memory_db()
    let standard_rows = try query_args(db, "select replace(replace(?1, '-', '+'), '_', '/') as r", [text])
    if standard_rows.is_empty { fail RigError.BadRequest("bad token") }
    let changing standard = standard_rows[0].get("r") otherwise ""
    while standard.length % 4 != 0 {
        standard = "{standard}="
    }
    match Bytes.from_base64(standard) {
        when success raw then {
            let hex = raw.to_hex()
            let ok_rows = try query_args(db, "select case when ?1 glob '[0-9A-Fa-f]*' and (length(?1) % 2) = 0 then 'yes' else 'no' end as r", [hex])
            let ok = ok_rows[0].get("r") otherwise "no"
            if ok != "yes" { fail RigError.BadRequest("bad token") }
            let decoded = try query_args(db, "select cast(x'{hex}' as text) as r", [])
            if decoded.is_empty { fail RigError.BadRequest("bad token") }
            return decoded[0].get("r") otherwise ""
        }
        when failure _ then { fail RigError.BadRequest("bad token") }
    }
}

to jwt_seconds(db: Db) returns Int {
    match config_get(db, "jwt_expiry") {
        when success value then match from_json(value, as: Int) {
            when success n then {
                if n > 0 { return n }
                return 3600
            }
            when failure _ then { return 3600 }
        }
        when failure _ then { return 3600 }
    }
}

to sign_jwt(db: Db, id: Text, email: Text, role: Text) returns Text or fails RigError {
    let secret = try auth_secret()
    let exp = now() + jwt_seconds(db)
    let iat = now()
    let mem = try memory_db()
    let payload_rows = try query_args(mem, "select json_object('role', ?1, 'sub', ?2, 'email', ?3, 'exp', cast(?4 as integer), 'iat', cast(?5 as integer)) as r", [role, id, email, "{exp}", "{iat}"])
    if payload_rows.is_empty { fail RigError.Database("jwt payload") }
    let payload = payload_rows[0].get("r") otherwise ""
    let payload_b64 = try b64url_text(payload)
    let signing = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.{payload_b64}"
    let sig_hex = try mac_hex(secret, signing)
    let sig = try b64url_hex(sig_hex)
    return "{signing}.{sig}"
}

to verify_jwt(token: Text) returns JwtClaims or fails RigError {
    let db = try memory_db()
    let sql = "select substr(?1, 1, instr(?1, '.') - 1) as header, substr(?1, instr(?1, '.') + 1, instr(substr(?1, instr(?1, '.') + 1), '.') - 1) as payload, substr(?1, instr(?1, '.') + instr(substr(?1, instr(?1, '.') + 1), '.') + 1) as sig"
    let rows = try query_args(db, sql, [token])
    if rows.is_empty { fail RigError.Unauthorized }
    let header = rows[0].get("header") otherwise ""
    let payload = rows[0].get("payload") otherwise ""
    let sig = rows[0].get("sig") otherwise ""
    if header.is_empty or payload.is_empty or sig.is_empty { fail RigError.Unauthorized }
    let secret = try auth_secret()
    let expected_hex = try mac_hex(secret, "{header}.{payload}")
    let expected = try b64url_hex(expected_hex)
    if expected != sig { fail RigError.Unauthorized }
    let json = try b64url_decode(payload)
    match from_json(json, as: JwtClaims) {
        when success claims then {
            if claims.exp < now() { fail RigError.Unauthorized }
            return claims
        }
        when failure _ then { fail RigError.Unauthorized }
    }
}

to hash_password(password: Text) returns Text or fails RigError {
    let secret = try auth_secret()
    let salt_full = try digest_text("{password.length}.{now()}.{Clock.millis()}")
    let db = try memory_db()
    let salt_rows = try query_args(db, "select substr(?1, 1, 16) as r", [salt_full])
    let salt = salt_rows[0].get("r") otherwise ""
    let mac = try mac_hex(secret, "{salt}.{password}")
    return "v1${salt}{mac}"
}

to password_matches(stored: Text, password: Text) returns Bool or fails RigError {
    if stored.length < 20 { return no }
    let db = try memory_db()
    let rows = try query_args(db, "select substr(?1, 4, 16) as salt, substr(?1, 20) as mac", [stored])
    if rows.is_empty { return no }
    let salt = rows[0].get("salt") otherwise ""
    let expect = rows[0].get("mac") otherwise ""
    let secret = try auth_secret()
    let actual = try mac_hex(secret, "{salt}.{password}")
    if actual == expect { return yes }
    return no
}

to store_password(db: Db, id: Text, password: Text) returns Int or fails RigError {
    if password.is_empty { return 0 }
    let hash = try hash_password(password)
    match db.from("auth_passwords").equals("user_id", id).first() {
        when success maybe then match maybe {
            when found _ then match db.from("auth_passwords").equals("user_id", id).update({"password_hash": hash}) {
                when success count then { return count }
                when failure error then match error {
                    when Failed(message) then { fail RigError.Database(message) }
                }
            }
            when nothing then match db.from("auth_passwords").insert({"user_id": id, "password_hash": hash}) {
                when success count then { return count }
                when failure error then match error {
                    when Failed(message) then { fail RigError.Database(message) }
                }
            }
        }
        when failure error then match error {
            when Failed(message) then { fail RigError.Database(message) }
        }
    }
}

to issue_session(db: Db, id: Text, email: Text) returns AuthSession or fails RigError {
    let secret = try auth_secret()
    let access = try sign_jwt(db, id, email, "authenticated")
    let refresh = try mac_hex(secret, "{id}.{email}.{now()}.{Clock.millis()}")
    let token_hash = try digest_text(refresh)
    let expires = now() + 1209600
    let refresh_id = "rt-{Clock.millis()}"
    match db.from("auth_refresh_tokens").insert({
        "id": refresh_id,
        "user_id": id,
        "token_hash": token_hash,
        "expires_at": "{expires}",
    }) {
        when success _ then {}
        when failure error then match error {
            when Failed(message) then { fail RigError.Database(message) }
        }
    }
    let seconds = jwt_seconds(db)
    return AuthSession.new(
        access_token: access,
        refresh_token: refresh,
        token_type: "bearer",
        expires_in: seconds,
        user: AuthUserResponse.new(id: id, email: email, role: "authenticated"),
    )
}

to min_password_length(db: Db) returns Int {
    match config_get(db, "min_password_length") {
        when success value then match from_json(value, as: Int) {
            when success n then {
                if n > 0 { return n }
                return 6
            }
            when failure _ then { return 6 }
        }
        when failure _ then { return 6 }
    }
}

to signup_user(body: AuthSignupBody) returns AuthSession or fails RigError {
    if body.email.is_empty or body.password.is_empty {
        fail RigError.BadRequest("email and password required")
    }
    let db = try RigRoutes.db()
    match config_get(db, "email_enabled") {
        when success value then {
            if value == "false" { fail RigError.BadRequest("email signups are disabled") }
        }
        when failure _ then {}
    }
    let min_len = min_password_length(db)
    if body.password.length < min_len {
        fail RigError.BadRequest("password is too short")
    }
    match db.from("auth_users").equals("email", body.email).first() {
        when success maybe then match maybe {
            when found _ then { fail RigError.BadRequest("email already registered") }
            when nothing then {}
        }
        when failure error then match error {
            when Failed(message) then { fail RigError.Database(message) }
        }
    }
    let id = "user-{Clock.millis()}"
    match db.from("auth_users").insert({
        "id": id,
        "email": body.email,
        "phone": "",
        "provider": "email",
        "created_at": "{now()}",
        "last_sign_in_at": "{now()}",
        "raw_user_meta_data": "",
        "banned_until": "",
    }) {
        when success _ then {}
        when failure error then match error {
            when Failed(message) then { fail RigError.Database(message) }
        }
    }
    match db.from("profiles").insert({"id": id, "email": body.email, "name": ""}) {
        when success _ then {}
        when failure _ then {}
    }
    let _p = try store_password(db, id, body.password)
    return try issue_session(db, id, body.email)
}

to user_by_email(db: Db, email: Text) returns {Text: Text} or fails RigError {
    match db.from("auth_users").equals("email", email).first() {
        when success maybe then match maybe {
            when found row then { return row }
            when nothing then { fail RigError.Unauthorized }
        }
        when failure error then match error {
            when Failed(message) then { fail RigError.Database(message) }
        }
    }
}

to password_grant(db: Db, email: Text, password: Text) returns AuthSession or fails RigError {
    let user = try user_by_email(db, email)
    let id = user.get("id") otherwise ""
    let banned = user.get("banned_until") otherwise ""
    if not banned.is_empty {
        match from_json(banned, as: Int) {
            when success n then {
                if n >= now() { fail RigError.Unauthorized }
            }
            when failure _ then { fail RigError.Unauthorized }
        }
    }
    match db.from("auth_passwords").equals("user_id", id).first() {
        when success maybe then match maybe {
            when found row then {
                let stored = row.get("password_hash") otherwise ""
                let ok = try password_matches(stored, password)
                if not ok { fail RigError.Unauthorized }
            }
            when nothing then { fail RigError.Unauthorized }
        }
        when failure error then match error {
            when Failed(message) then { fail RigError.Database(message) }
        }
    }
    match db.from("auth_users").equals("id", id).update({"last_sign_in_at": "{now()}"}) {
        when success _ then {}
        when failure _ then {}
    }
    return try issue_session(db, id, email)
}

to refresh_grant(db: Db, token: Text) returns AuthSession or fails RigError {
    if token.is_empty { fail RigError.Unauthorized }
    let token_hash = try digest_text(token)
    match db.from("auth_refresh_tokens").equals("token_hash", token_hash).first() {
        when success maybe then match maybe {
            when found row then {
                let expires = row.get("expires_at") otherwise "0"
                match from_json(expires, as: Int) {
                    when success n then {
                        if n < now() { fail RigError.Unauthorized }
                    }
                    when failure _ then { fail RigError.Unauthorized }
                }
                let user_id = row.get("user_id") otherwise ""
                let token_id = row.get("id") otherwise ""
                match db.from("auth_refresh_tokens").equals("id", token_id).delete() {
                    when success _ then {}
                    when failure _ then {}
                }
                match db.from("auth_users").equals("id", user_id).first() {
                    when success maybe then match maybe {
                        when found user then {
                            let email = user.get("email") otherwise ""
                            return try issue_session(db, user_id, email)
                        }
                        when nothing then { fail RigError.Unauthorized }
                    }
                    when failure error then match error {
                        when Failed(message) then { fail RigError.Database(message) }
                    }
                }
            }
            when nothing then { fail RigError.Unauthorized }
        }
        when failure error then match error {
            when Failed(message) then { fail RigError.Database(message) }
        }
    }
}

to token_user(body: AuthTokenBody) returns AuthSession or fails RigError {
    let db = try RigRoutes.db()
    if body.grant_type == "refresh_token" {
        return try refresh_grant(db, body.refresh_token)
    }
    if body.email.is_empty or body.password.is_empty {
        fail RigError.BadRequest("email and password required")
    }
    return try password_grant(db, body.email, body.password)
}

to current_user(headers: {Text: Text}, who: User or fails AuthError) returns AuthUserResponse or fails RigError {
    let authorization = header_get(headers, "authorization")
    let token = try bearer_token(authorization)
    if not token.is_empty and token != anon_key() {
        let claims = try verify_jwt(token)
        return AuthUserResponse.new(id: claims.sub, email: claims.email, role: claims.role)
    }
    let user = try require_user(who)
    return AuthUserResponse.new(id: user.id, email: user.email, role: "authenticated")
}

to rest_actor(headers: {Text: Text}) returns Actor or fails RigError {
    let anon = anon_key()
    let apikey = header_get(headers, "apikey")
    let token = try bearer_token(header_get(headers, "authorization"))
    if apikey == anon or token == anon {
        return Actor.new(role: "anon", uid: "")
    }
    if not token.is_empty {
        let claims = try verify_jwt(token)
        let role = if claims.role == "anon" { "anon" } else { "authenticated" }
        return Actor.new(role: role, uid: claims.sub)
    }
    fail RigError.Unauthorized
}

to studio_actor(headers: {Text: Text}) returns Actor {
    let role = header_get(headers, "x-rig-role")
    let uid = header_get(headers, "x-rig-user")
    if role == "anon" { return Actor.new(role: "anon", uid: "") }
    if role == "authenticated" { return Actor.new(role: "authenticated", uid: uid) }
    return Actor.new(role: "postgres", uid: "")
}

# --- Mounted HTTP route groups (`mount rig_studio`, `mount rig_api`, etc.) --

cast RigRoutes {
    factory client() returns Client or fails RigError {
        let url = env.get("RIG_DATABASE_URL") otherwise "sqlite:rig.db"
        let root = env.get("RIG_STORAGE_ROOT") otherwise "rig-storage"
        return connect_with(url, root)
    }

    factory db() returns Db or fails RigError {
        let client = try RigRoutes.client()
        return open_db(client)
    }

    factory api_tables() returns [StudioTableInfo] or fails RigError {
        let db = try RigRoutes.db()
        return try list_studio_tables(db)
    }

    factory list_table(table: Text, actor: Actor) returns [{Text: Text}] or fails RigError {
        let db = try RigRoutes.db()
        let rows = try list_as(db, table, actor)
        let _l = log_studio(db, "api", "info", "GET", "/rest/v1/{table}", "select {table}", "200", "0")
        return rows
    }

    factory get_table_row(table: Text, id: Text, actor: Actor) returns {Text: Text} or fails RigError {
        let db = try RigRoutes.db()
        let row = try get_as(db, table, id, actor)
        let _l = log_studio(db, "api", "info", "GET", "/rest/v1/{table}/{id}", "get {table} {id}", "200", "0")
        return row
    }

    factory insert_table_row(table: Text, values: {Text: Text}, actor: Actor) returns OkCount or fails RigError {
        let db = try RigRoutes.db()
        let count = try insert_row_as(db, table, values, actor)
        let _l = log_studio(db, "api", "info", "POST", "/rest/v1/{table}", "insert {table}", "201", "0")
        return OkCount.new(count: count)
    }

    factory patch_table_row(table: Text, id: Text, values: {Text: Text}, actor: Actor) returns OkCount or fails RigError {
        let db = try RigRoutes.db()
        let count = try patch_row_as(db, table, id, values, actor)
        let _l = log_studio(db, "api", "info", "PATCH", "/rest/v1/{table}/{id}", "patch {table} {id}", "200", "0")
        return OkCount.new(count: count)
    }

    factory delete_table_row(table: Text, id: Text, actor: Actor) returns OkCount or fails RigError {
        let db = try RigRoutes.db()
        let count = try remove_as(db, table, id, actor)
        let _l = log_studio(db, "api", "info", "DELETE", "/rest/v1/{table}/{id}", "delete {table} {id}", "200", "0")
        return OkCount.new(count: count)
    }

    factory list_profiles() returns [{Text: Text}] or fails RigError {
        let db = try RigRoutes.db()
        return list(db, "profiles")
    }

    factory user(who: User or fails AuthError) returns UserView or fails RigError {
        let user = try require_user(who)
        return user_view(user)
    }

    factory storage_file(filepath: Text) returns Text or fails RigError {
        let client = try RigRoutes.client()
        return try resolve_object(client.storage_root, filepath)
    }

    factory storage_listing() returns StudioStorage or fails RigError {
        let client = try RigRoutes.client()
        let empty: [Text] = []
        return StudioStorage.new(root: client.storage_root, entries: empty)
    }

    factory auth_config() returns StudioAuthConfigView or fails RigError {
        let db = try RigRoutes.db()
        return try get_auth_config(db)
    }

    factory save_auth_config(body: StudioAuthConfigBody) returns StudioAuthConfigView or fails RigError {
        let db = try RigRoutes.db()
        return try put_auth_config(db, body)
    }

    factory studio_insert(body: StudioInsertBody) returns OkCount or fails RigError {
        let db = try RigRoutes.db()
        let count = try insert_studio_row(db, body)
        return OkCount.new(count: count)
    }

    factory studio_patch(body: StudioPatchBody, actor: Actor) returns OkCount or fails RigError {
        let db = try RigRoutes.db()
        let count = try patch_studio_row(db, body, actor)
        return OkCount.new(count: count)
    }

    factory studio_tables() returns [StudioTableInfo] or fails RigError {
        let db = try RigRoutes.db()
        return try list_studio_tables(db)
    }

    factory studio_sql(sql: Text) returns [{Text: Text}] or fails RigError {
        let db = try RigRoutes.db()
        return try run_studio_sql(db, sql)
    }

    factory studio_ddl(body: StudioDdlBody) returns [{Text: Text}] or fails RigError {
        let db = try RigRoutes.db()
        return try run_studio_ddl(db, body)
    }

    factory studio_row_query(body: StudioRowQuery, actor: Actor) returns StudioRowPage or fails RigError {
        let db = try RigRoutes.db()
        return try query_studio_rows(db, body, actor)
    }

    factory studio_row_insert(body: StudioRowWrite, actor: Actor) returns OkCount or fails RigError {
        let db = try RigRoutes.db()
        let count = try insert_studio_values(db, body, actor)
        return OkCount.new(count: count)
    }

    factory studio_row_patch(body: StudioRowWrite, actor: Actor) returns OkCount or fails RigError {
        let db = try RigRoutes.db()
        let count = try patch_studio_values(db, body, actor)
        return OkCount.new(count: count)
    }

    factory studio_row_delete(body: StudioRowDelete, actor: Actor) returns OkCount or fails RigError {
        let db = try RigRoutes.db()
        let count = try delete_studio_ids(db, body, actor)
        return OkCount.new(count: count)
    }

    factory snippets() returns [{Text: Text}] or fails RigError {
        let db = try RigRoutes.db()
        return try list_snippets(db)
    }

    factory snippet_save(body: StudioSnippetBody) returns OkCount or fails RigError {
        let db = try RigRoutes.db()
        let count = try save_snippet(db, body)
        return OkCount.new(count: count)
    }

    factory snippet_delete(body: StudioSnippetBody) returns OkCount or fails RigError {
        let db = try RigRoutes.db()
        let count = try delete_snippet(db, body)
        return OkCount.new(count: count)
    }

    factory auth_users() returns [{Text: Text}] or fails RigError {
        let db = try RigRoutes.db()
        return try list_auth_users(db)
    }

    factory auth_user_save(body: StudioAuthUserBody) returns OkCount or fails RigError {
        let db = try RigRoutes.db()
        let count = try save_auth_user(db, body)
        return OkCount.new(count: count)
    }

    factory auth_user_delete(body: StudioAuthUserBody) returns OkCount or fails RigError {
        let db = try RigRoutes.db()
        let count = try delete_auth_user(db, body)
        return OkCount.new(count: count)
    }

    factory policies() returns [{Text: Text}] or fails RigError {
        let db = try RigRoutes.db()
        return try list_policies(db)
    }

    factory policy_save(body: StudioPolicyBody) returns OkCount or fails RigError {
        let db = try RigRoutes.db()
        let count = try save_policy(db, body)
        return OkCount.new(count: count)
    }

    factory policy_delete(body: StudioPolicyBody) returns OkCount or fails RigError {
        let db = try RigRoutes.db()
        let count = try delete_policy(db, body)
        return OkCount.new(count: count)
    }

    factory buckets() returns [{Text: Text}] or fails RigError {
        let db = try RigRoutes.db()
        return try list_buckets(db)
    }

    factory bucket_save(body: StudioBucketBody) returns OkCount or fails RigError {
        let db = try RigRoutes.db()
        let count = try save_bucket(db, body)
        return OkCount.new(count: count)
    }

    factory objects() returns [{Text: Text}] or fails RigError {
        let db = try RigRoutes.db()
        return try list_objects(db)
    }

    factory object_save(body: StudioObjectBody) returns OkCount or fails RigError {
        let db = try RigRoutes.db()
        let count = try save_object(db, body)
        return OkCount.new(count: count)
    }

    factory object_delete(body: StudioObjectDelete) returns OkCount or fails RigError {
        let db = try RigRoutes.db()
        let count = try delete_object(db, body)
        return OkCount.new(count: count)
    }

    factory functions() returns [{Text: Text}] or fails RigError {
        let db = try RigRoutes.db()
        return try list_functions(db)
    }

    factory function_save(body: StudioFunctionBody) returns StudioFunctionResult or fails RigError {
        let db = try RigRoutes.db()
        return try save_function(db, body)
    }

    factory logs() returns [{Text: Text}] or fails RigError {
        let db = try RigRoutes.db()
        return try list_studio_logs(db)
    }

    factory logs_query(body: StudioLogQuery) returns [{Text: Text}] or fails RigError {
        let db = try RigRoutes.db()
        return try query_studio_logs(db, body)
    }

    factory advisors() returns [{Text: Text}] or fails RigError {
        let db = try RigRoutes.db()
        return try list_advisors(db)
    }

    factory migrations() returns [{Text: Text}] or fails RigError {
        let db = try RigRoutes.db()
        return try list_migrations(db)
    }

    factory migration_save(body: StudioMigrationBody) returns OkCount or fails RigError {
        let db = try RigRoutes.db()
        let count = try save_migration(db, body)
        return OkCount.new(count: count)
    }

    factory webhooks() returns [{Text: Text}] or fails RigError {
        let db = try RigRoutes.db()
        return try list_webhooks(db)
    }

    factory webhook_save(body: StudioWebhookBody) returns OkCount or fails RigError {
        let db = try RigRoutes.db()
        let count = try save_webhook(db, body)
        return OkCount.new(count: count)
    }

    factory riff_catalog() returns [RiffPackage] or fails RigError {
        let db = try RigRoutes.db()
        return catalog_riffs(db)
    }

    factory riff_package(name: Text) returns RiffPackage or fails RigError {
        let db = try RigRoutes.db()
        return package_with_downloads(db, name)
    }

    factory riff_history(name: Text) returns [{Text: Text}] or fails RigError {
        let db = try RigRoutes.db()
        return install_history(db, name)
    }

    factory riff_track_install(name: Text) returns RiffTracked or fails RigError {
        let db = try RigRoutes.db()
        if not riff_name_ok(db, name) {
            fail RigError.BadRequest("riff not found")
        }
        let downloads = try track_riff(db, name, "install")
        return RiffTracked.new(ok: yes, downloads: downloads)
    }

    factory riff_track_view(name: Text) returns RiffViewed or fails RigError {
        let db = try RigRoutes.db()
        if not riff_name_ok(db, name) {
            fail RigError.BadRequest("riff not found")
        }
        let views = try track_riff(db, name, "view")
        return RiffViewed.new(ok: yes, views: views)
    }
}

mount rig_registry at "/api" {
    route get "/riffs" {
        match RigRoutes.riff_catalog() {
            when success rows then { reply with rows }
            when failure error then {
                reply text explain(error) as "text/plain; charset=utf-8" status 400
            }
        }
    }

    route get "/riffs/{name: Text}" {
        match RigRoutes.riff_package(name) {
            when success pkg then { reply with pkg }
            when failure error then {
                reply text explain(error) as "text/plain; charset=utf-8" status 400
            }
        }
    }

    route get "/riffs/{name: Text}/history" {
        match RigRoutes.riff_history(name) {
            when success rows then { reply with rows }
            when failure error then {
                reply text explain(error) as "text/plain; charset=utf-8" status 400
            }
        }
    }

    route post "/riffs/{name: Text}/track" {
        match RigRoutes.riff_track_install(name) {
            when success tracked then { reply with tracked }
            when failure error then {
                reply text explain(error) as "text/plain; charset=utf-8" status 400
            }
        }
    }

    route post "/riffs/{name: Text}/view" {
        match RigRoutes.riff_track_view(name) {
            when success viewed then { reply with viewed }
            when failure error then {
                reply text explain(error) as "text/plain; charset=utf-8" status 400
            }
        }
    }
}

mount rig_health at "/" {
    route get "/health" {
        reply with health()
    }
}

mount rig_auth at "/auth/v1" {
    route get "/health" {
        reply with auth_health()
    }

    route get "/user" {
        match current_user(request.headers, request.who) {
            when success view then { reply with view }
            when failure error then { reply text explain(error) as "text/plain" status 401 }
        }
    }

    route post "/signup" expecting AuthSignupBody as body {
        match signup_user(body) {
            when success session then { reply with session status 201 }
            when failure error then { reply text explain(error) as "text/plain" status 400 }
        }
    }

    route post "/token" expecting AuthTokenBody as body {
        match token_user(body) {
            when success session then { reply with session }
            when failure error then { reply text explain(error) as "text/plain" status 401 }
        }
    }
}

mount rig_api at "/rest/v1" {
    mount rig_health

    route get "/" {
        match rest_actor(request.headers) {
            when success _ then match RigRoutes.api_tables() {
                when success tables then { reply with tables }
                when failure error then { reply text explain(error) as "text/plain" status 500 }
            }
            when failure _ then { reply text "unauthorized" as "text/plain" status 401 }
        }
    }

    route get "/{table: Text}" {
        match rest_actor(request.headers) {
            when success actor then match RigRoutes.list_table(table, actor) {
                when success rows then { reply with rows }
                when failure error then { reply text explain(error) as "text/plain" status 400 }
            }
            when failure _ then { reply text "unauthorized" as "text/plain" status 401 }
        }
    }

    route get "/{table: Text}/{id: Text}" {
        match rest_actor(request.headers) {
            when success actor then match RigRoutes.get_table_row(table, id, actor) {
                when success row then { reply with row }
                when failure error then {
                    let code = http_status(error)
                    reply text explain(error) as "text/plain" status code
                }
            }
            when failure _ then { reply text "unauthorized" as "text/plain" status 401 }
        }
    }

    route post "/{table: Text}" expecting {Text: Text} as body {
        match rest_actor(request.headers) {
            when success actor then match RigRoutes.insert_table_row(table, body, actor) {
                when success count then { reply with count status 201 }
                when failure error then {
                    let code = http_status(error)
                    reply text explain(error) as "text/plain" status code
                }
            }
            when failure _ then { reply text "unauthorized" as "text/plain" status 401 }
        }
    }

    route patch "/{table: Text}/{id: Text}" expecting {Text: Text} as body {
        match rest_actor(request.headers) {
            when success actor then match RigRoutes.patch_table_row(table, id, body, actor) {
                when success count then { reply with count }
                when failure error then {
                    let code = http_status(error)
                    reply text explain(error) as "text/plain" status code
                }
            }
            when failure _ then { reply text "unauthorized" as "text/plain" status 401 }
        }
    }

    route delete "/{table: Text}/{id: Text}" {
        match rest_actor(request.headers) {
            when success actor then match RigRoutes.delete_table_row(table, id, actor) {
                when success count then { reply with count }
                when failure error then {
                    let code = http_status(error)
                    reply text explain(error) as "text/plain" status code
                }
            }
            when failure _ then { reply text "unauthorized" as "text/plain" status 401 }
        }
    }
}

mount rig_storage at "/storage/v1" {
    route get "/object/{*filepath}" {
        match RigRoutes.storage_file(filepath) {
            when success target then {
                reply file target
            }
            when failure error then {
                reply text explain(error) as "text/plain; charset=utf-8" status 400
            }
        }
    }
}

mount rig_studio_assets at "/studio" {
    route get "/rig-mark.svg" {
        let studio = default_studio()
        match authorize_studio(studio, request.headers) {
            when success _ then match resolve_studio(studio, "rig-mark.svg") {
                when success target then { reply file target }
                when failure error then {
                    reply text explain(error) as "text/plain" status 404
                }
            }
            when failure _ then {
                reply text "unauthorized" as "text/plain" status 401
            }
        }
    }

    route get "/assets/{*filepath}" {
        let studio = default_studio()
        match authorize_studio(studio, request.headers) {
            when success _ then match resolve_studio(studio, "assets/{filepath}") {
                when success target then { reply file target }
                when failure error then {
                    reply text explain(error) as "text/plain" status 404
                }
            }
            when failure _ then {
                reply text "unauthorized" as "text/plain" status 401
            }
        }
    }
}

