mount rig_studio at "/studio" {
    mount rig_studio_api
    mount rig_studio_assets

    route get "/" {
        let studio = default_studio()
        match authorize_studio(studio, request.headers) {
            when success _ then match resolve_studio(studio, "") {
                when success target then { reply file target }
                when failure error then {
                    reply text explain(error) as "text/plain" status 404
                }
            }
            when failure _ then {
                reply text "unauthorized" as "text/plain" status 401
            }
        }
    }

    route get "/{*filepath}" {
        let studio = default_studio()
        match authorize_studio(studio, request.headers) {
            when success _ then match resolve_studio(studio, filepath) {
                when success target then { reply file target }
                when failure error then {
                    reply text explain(error) as "text/plain" status 404
                }
            }
            when failure _ then {
                reply text "unauthorized" as "text/plain" status 401
            }
        }
    }
}

mount rig_riff at "" {
    mount rig_registry at "/api"
    mount rig_auth at "/auth/v1"
    mount rig_api at "/rest/v1"
    mount rig_storage at "/storage/v1"
    mount rig_studio at "/studio"

    route get "/health" {
        reply with registry_health()
    }

    route get "/" {
        match resolve_catalog("index.html") {
            when success target then { reply file target }
            when failure error then {
                reply text explain(error) as "text/plain; charset=utf-8" status 403
            }
        }
    }

    route get "/packages/{name: Text}" {
        match resolve_catalog("index.html") {
            when success target then { reply file target }
            when failure error then {
                reply text explain(error) as "text/plain; charset=utf-8" status 403
            }
        }
    }

    route get "/{*filepath}" {
        match resolve_catalog(filepath) {
            when success target then { reply file target }
            when failure error then {
                reply text explain(error) as "text/plain; charset=utf-8" status 403
            }
        }
    }
}

mount rig {
    mount rig_auth
    mount rig_api
    mount rig_storage
    mount rig_studio
}

mount rig_all {
    mount rig_auth
    mount rig_api
    mount rig_storage
    mount rig_studio
}
