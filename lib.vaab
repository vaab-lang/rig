                when success rows then { reply with rows }
                when failure error then {
                    reply text explain(error) as "text/plain; charset=utf-8" status 500
                }
            }
            when failure _ then {
                reply text "unauthorized" as "text/plain" status 401
            }
        }
    }

    route post "/migrations" expecting StudioMigrationBody as body {
        match authorize_studio(default_studio(), request.headers) {
            when success _ then match RigRoutes.migration_save(body) {
                when success count then { reply with count }
                when failure error then {
                    reply text explain(error) as "text/plain; charset=utf-8" status 400
                }
            }
            when failure _ then {
                reply text "unauthorized" as "text/plain" status 401
            }
        }
    }

    route get "/webhooks" {
        match authorize_studio(default_studio(), request.headers) {
            when success _ then match RigRoutes.webhooks() {
                when success rows then { reply with rows }
                when failure error then {
                    reply text explain(error) as "text/plain; charset=utf-8" status 500
                }
            }
            when failure _ then {
                reply text "unauthorized" as "text/plain" status 401
            }
        }
    }

    route post "/webhooks" expecting StudioWebhookBody as body {
        match authorize_studio(default_studio(), request.headers) {
            when success _ then match RigRoutes.webhook_save(body) {
                when success count then { reply with count }
                when failure error then {
                    reply text explain(error) as "text/plain; charset=utf-8" status 400
                }
            }
            when failure _ then {
                reply text "unauthorized" as "text/plain" status 401
            }
        }
    }
}

mount rig_studio at "/studio" {
    mount rig_studio_api
    mount rig_studio_assets

    route get "/" {
        let studio = default_studio()
        match authorize_studio(studio, request.headers) {
            when success _ then match resolve_studio(studio, "") {
                when success target then { reply file target }
                when failure error then {
                    reply text explain(error) as "text/plain" status 404
                }
            }
            when failure _ then {
                reply text "unauthorized" as "text/plain" status 401
            }
        }
    }

    route get "/{*filepath}" {
        let studio = default_studio()
        match authorize_studio(studio, request.headers) {
            when success _ then match resolve_studio(studio, filepath) {
                when success target then { reply file target }
                when failure error then {
                    reply text explain(error) as "text/plain" status 404
                }
            }
            when failure _ then {
                reply text "unauthorized" as "text/plain" status 401
            }
        }
    }
}

mount rig {
    mount rig_auth
    mount rig_api
    mount rig_storage
    mount rig_studio
}

mount rig_all {
    mount rig_auth
    mount rig_api
    mount rig_storage
    mount rig_studio
}
