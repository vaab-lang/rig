    let _co = try config_set(db, "custom_oauth_enabled", flag_text(incoming.custom_oauth_enabled))
    let _cn = try config_set(db, "custom_oauth_name", incoming.custom_oauth_name)
    let _ci = try config_set(db, "custom_oauth_client_id", incoming.custom_oauth_client_id)
    let _cs = try keep_or_set(db, "custom_oauth_client_secret", incoming.custom_oauth_client_secret)
    if not incoming.custom_oauth_client_secret.is_empty {
        let _c4 = try config_set(db, "custom_oauth_client_secret_last4", incoming.custom_oauth_client_secret_last4)
    }
    let _cu = try config_set(db, "custom_oauth_url", incoming.custom_oauth_url)
