# rig — Vaab's own Supabase-shaped backend helpers.
#
# tape is the static file deck. rig is the full backline: database REST,
# auth (via request.who), object storage paths, and a precompiled Studio UI —
# all mounted from a serve block.
#
#   need rig
#
#   serve on port 54321 {
#       mount rig_auth at "/auth/v1"
#       mount rig_api at "/rest/v1"
#       mount rig_storage at "/storage/v1"
#       mount rig_studio at "/studio"
#   }

choice RigError {
    Missing(name: Text)
    Database(message: Text)
    Unauthorized
    BadRequest(message: Text)
    NotFound(resource: Text)
    Forbidden(table: Text)
    Unsafe(requested: Text)
}

type Client {
    db_url: Text
    storage_root: Text
}

type Health {
    name: Text
    ok: Bool
    version: Text
}

# Same shape request.who expects (apps share this type via need rig).
type User {
    id: Text
    email: Text
}

type UserView {
    id: Text
    email: Text
}

type Todo {
    id: Text
    title: Text
    owner: Text
    done: Text
}

type NewTodo {
    title: Text
}

type OkCount {
    count: Int
}

# --- connect ---------------------------------------------------------------

to connect() returns Client or fails RigError {
    match require_env("RIG_DATABASE_URL") {
        when success db_url then match env.get("RIG_STORAGE_ROOT") {
            when found root then { return Client.new(db_url: db_url, storage_root: root) }
            when nothing then {
                return Client.new(db_url: db_url, storage_root: "rig-storage")
            }
        }
        when failure error then { fail error }
    }
}

to connect_with(db_url: Text, storage_root: Text) returns Client {
    return Client.new(db_url: db_url, storage_root: storage_root)
}

to require_env(name: Text) returns Text or fails RigError {
    match env.get(name) {
        when found value then { return value }
        when nothing then { fail RigError.Missing(name) }
    }
}

# --- database --------------------------------------------------------------

to open_url(db_url: Text) returns Db or fails RigError {
    match Db.connect(db_url) {
        when success db then match ensure_schema(db) {
            when success _ then { return db }
            when failure error then { fail error }
        }
        when failure error then match error {
            when Failed(message) then { fail RigError.Database(message) }
        }
    }
}

to open_db(client: Client) returns Db or fails RigError {
    return open_url(client.db_url)
}

to exec_sql(db: Db, sql: Text) returns Int or fails RigError {
    let empty: [Text] = []
    match db.execute(sql, empty) {
        when success count then { return count }
        when failure error then match error {
            when Failed(message) then { fail RigError.Database(message) }
        }
    }
}

to query_sql(db: Db, sql: Text) returns [{Text: Text}] or fails RigError {
    let empty: [Text] = []
    match db.query(sql, empty) {
        when success rows then { return rows }
        when failure error then match error {
            when Failed(message) then { fail RigError.Database(message) }
        }
    }
}

to row_text(row: {Text: Text}, key: Text) returns Text {
    return row.get(key) otherwise ""
}

to empty_rows() returns [{Text: Text}] {
    let none: [{Text: Text}] = []
    return none
}

to pragma_rows(db: Db, sql: Text) returns [{Text: Text}] {
    let empty: [Text] = []
    match db.query(sql, empty) {
        when success rows then { return rows }
        when failure _ then { return empty_rows() }
    }
}

to ident_ok(name: Text) returns Bool {
    if name.is_empty { return no }
    if name.contains(" ") { return no }
    if name.contains(";") { return no }
    if name.contains("'") { return no }
    if name.contains("\"") { return no }
    if name.contains("`") { return no }
    if name.contains("[") { return no }
    if name.contains("]") { return no }
    if name.contains("(") { return no }
    if name.contains(")") { return no }
    if name.contains(",") { return no }
    if name.contains(".") { return no }
    if name.contains("/") { return no }
    if name.contains("\\") { return no }
    if name.contains("=") { return no }
    if name.contains("*") { return no }
    if name.contains("%") { return no }
    if name.contains("#") { return no }
    if name.contains("-") { return no }
    if name.contains("--") { return no }
    if name.contains("/*") { return no }
    return yes
}

to ident(name: Text) returns Text or fails RigError {
    if ident_ok(name) {
        return name
    }
    fail RigError.BadRequest("bad identifier: {name}")
}

to names_ok(names: [Text], i: Int) returns Bool {
    if i >= names.count { return yes }
    if not ident_ok(names[i]) { return no }
    return names_ok(names, i + 1)
}

to values_ok(values: {Text: Text}) returns Bool {
    return names_ok(values.keys, 0)
}

to is_sqlite_name(name: Text) returns Bool {
    if name.contains("sqlite_") { return yes }
    if name == "sqlite_master" { return yes }
    return no
}

to is_credential_table(name: Text) returns Bool {
    if name == "studio_config" { return yes }
    return no
}

to allow_user_table(table: Text) returns Text or fails RigError {
    let name = try ident(table)
    if is_sqlite_name(name) {
        fail RigError.Forbidden(name)
    }
    if is_credential_table(name) {
        fail RigError.Forbidden(name)
    }
    return name
}

to ensure_schema(db: Db) returns Int or fails RigError {
    let _p = try exec_sql(db, "create table if not exists profiles (id text primary key, email text not null, name text not null default '')")
    let _t = try exec_sql(db, "create table if not exists todos (id text primary key, title text not null, owner text not null, done text not null default 'false')")
    let _r = try exec_sql(db, "create table if not exists riff_events (id text primary key, name text not null, kind text not null, ts text not null)")
    let _c = try exec_sql(db, "create table if not exists studio_config (key text primary key, value text not null)")
    let _u = try exec_sql(db, "create table if not exists auth_users (id text primary key, email text not null, phone text not null default '', provider text not null default 'email', created_at text not null, last_sign_in_at text not null default '', raw_user_meta_data text not null default '', banned_until text not null default '')")
    let _b = try exec_sql(db, "create table if not exists studio_buckets (id text primary key, name text not null, public text not null default 'false', file_size_limit text not null default '', allowed_mime_types text not null default '', created_at text not null, updated_at text not null)")
    let _o = try exec_sql(db, "create table if not exists studio_objects (id text primary key, bucket_id text not null, name text not null, size text not null default '0', mime_type text not null default '', content text not null default '', created_at text not null, updated_at text not null)")
    let _s = try exec_sql(db, "create table if not exists studio_snippets (id text primary key, name text not null, description text not null default '', sql text not null default '', folder text not null default 'Private', favorite text not null default 'false', visibility text not null default 'private', updated_at text not null)")
    let _l = try exec_sql(db, "create table if not exists studio_policies (id text primary key, schema_name text not null default 'public', table_name text not null, name text not null, action text not null default 'PERMISSIVE', roles text not null default 'public', command text not null, definition text not null default 'true', check_expr text not null default '')")
    let _f = try exec_sql(db, "create table if not exists studio_functions (id text primary key, slug text not null, name text not null, status text not null default 'active', version text not null default '1', entrypoint_path text not null default 'index.ts', verify_jwt text not null default 'true', code text not null default '', created_at text not null, updated_at text not null)")
    let _m = try exec_sql(db, "create table if not exists studio_migrations (version text primary key, name text not null, statements text not null default '', applied_at text not null)")
    let _g = try exec_sql(db, "create table if not exists studio_logs (id text primary key, ts text not null, service text not null, level text not null, status_code text not null default '', method text not null default '', path text not null default '', msg text not null default '', duration_ms text not null default '0')")
    let _w = try exec_sql(db, "create table if not exists studio_webhooks (id text primary key, name text not null, table_name text not null, events text not null default '', url text not null, method text not null default 'POST', headers text not null default '', enabled text not null default 'true', created_at text not null)")
    return try seed_studio(db)
}

to seed_studio(db: Db) returns Int or fails RigError {
    match db.from("studio_snippets").count() {
        when success n then {
            if n > 0 { return n }
            let ts = "{now()}"
            match db.from("studio_snippets").insert({"id": "tpl-create-table", "name": "Create table", "description": "Create a table", "sql": "create table items (id text primary key, name text not null)", "folder": "Templates", "favorite": "false", "visibility": "shared", "updated_at": ts}) {
                when success _ then {}
                when failure error then match error {
                    when Failed(message) then { fail RigError.Database(message) }
                }
            }
            match db.from("studio_snippets").insert({"id": "tpl-rls", "name": "Enable RLS read", "description": "Select for all users", "sql": "create policy read_all on items for select using (true)", "folder": "Templates", "favorite": "false", "visibility": "shared", "updated_at": ts}) {
                when success count then { return count }
                when failure error then match error {
                    when Failed(message) then { fail RigError.Database(message) }
                }
            }
        }
        when failure error then match error {
            when Failed(message) then { fail RigError.Database(message) }
        }
    }
}

# --- riff registry telemetry (riff.vaab.dev) --------------------------------

to known_riff(name: Text) returns Bool {
    if name == "supabase" { return yes }
    if name == "tape" { return yes }
    if name == "rig" { return yes }
    return no
}

to riff_name_ok(name: Text) returns Bool {
    if name.is_empty { return no }
    if name.contains("..") { return no }
    if name.contains("/") { return no }
    if name.contains(":") { return no }
    if name.contains(" ") { return no }
    return known_riff(name)
}

to track_riff(db: Db, name: Text, kind: Text) returns Int or fails RigError {
    if not riff_name_ok(name) {
        fail RigError.BadRequest("unknown or bad riff name")
    }
    let existing = try count_riff(db, name)
    let next = existing + 1
    let id = "{name}-{kind}-{now()}-{next}"
    match db.from("riff_events").insert({"id": id, "name": name, "kind": kind, "ts": "{now()}"}) {
        when success _ then { return next }
        when failure error then match error {
            when Failed(message) then { fail RigError.Database(message) }
        }
    }
}

to count_riff(db: Db, name: Text) returns Int or fails RigError {
    if not riff_name_ok(name) {
        fail RigError.BadRequest("unknown or bad riff name")
    }
    match db.from("riff_events").equals("name", name).count() {
        when success n then { return n }
        when failure error then match error {
            when Failed(message) then { fail RigError.Database(message) }
        }
    }
}

to allow_table(table: Text) returns Text or fails RigError {
    if table == "todos" { return table }
    if table == "profiles" { return table }
    fail RigError.Forbidden(table)
}

to list(db: Db, table: Text) returns [{Text: Text}] or fails RigError {
    if table != "todos" {
        if table != "profiles" {
            fail RigError.Forbidden(table)
        }
    }
    match db.from(table).order_desc("id").all() {
        when success rows then { return rows }
        when failure error then match error {
            when Failed(message) then { fail RigError.Database(message) }
        }
    }
}

to list_where(db: Db, table: Text, column: Text, value: Text) returns [{Text: Text}] or fails RigError {
    if table != "todos" {
        if table != "profiles" {
            fail RigError.Forbidden(table)
        }
    }
    match db.from(table).equals(column, value).order_desc("id").all() {
        when success rows then { return rows }
        when failure error then match error {
            when Failed(message) then { fail RigError.Database(message) }
        }
    }
}

to get(db: Db, table: Text, id: Text) returns {Text: Text} or fails RigError {
    if table != "todos" {
        if table != "profiles" {
            fail RigError.Forbidden(table)
        }
    }
    match db.from(table).equals("id", id).first() {
        when success maybe then match maybe {
            when found row then { return row }
            when nothing then { fail RigError.NotFound(id) }
        }
        when failure error then match error {
            when Failed(message) then { fail RigError.Database(message) }
        }
    }
}

to insert_todo(db: Db, id: Text, title: Text, owner: Text) returns Int or fails RigError {
    match db.from("todos").insert({"id": id, "title": title, "owner": owner, "done": "false"}) {
        when success count then { return count }
        when failure error then match error {
            when Failed(message) then { fail RigError.Database(message) }
        }
    }
}

to insert_profile(db: Db, id: Text, email: Text, name: Text) returns Int or fails RigError {
    match db.from("profiles").insert({"id": id, "email": email, "name": name}) {
        when success count then { return count }
        when failure error then match error {
            when Failed(message) then { fail RigError.Database(message) }
        }
    }
}

to patch_todo_done(db: Db, id: Text, done: Text) returns Int or fails RigError {
    match db.from("todos").equals("id", id).update({"done": done}) {
        when success count then {
            if count == 0 { fail RigError.NotFound(id) }
            return count
        }
        when failure error then match error {
            when Failed(message) then { fail RigError.Database(message) }
        }
    }
}

to remove(db: Db, table: Text, id: Text) returns Int or fails RigError {
    if table != "todos" {
        if table != "profiles" {
            fail RigError.Forbidden(table)
        }
    }
    match db.from(table).equals("id", id).delete() {
        when success count then {
            if count == 0 { fail RigError.NotFound(id) }
            return count
        }
        when failure error then match error {
            when Failed(message) then { fail RigError.Database(message) }
        }
    }
}

# --- auth (builtin request.who; rig only adapts) ---------------------------

to require_user(who: User or fails AuthError) returns User or fails RigError {
    match who {
        when success user then { return user }
        when failure _ then { fail RigError.Unauthorized }
    }
}

to user_view(user: User) returns UserView {
    return UserView.new(id: user.id, email: user.email)
}

# --- object storage paths (tape's sibling for /storage) --------------------

to resolve_object(root: Text, requested: Text) returns Text or fails RigError {
    if requested.contains("..") {
        fail RigError.Unsafe(requested)
    }
    if requested.is_empty {
        fail RigError.BadRequest("empty object path")
    }
    return "{root}/{requested}"
}

# --- Studio (tape-shaped static mount, gated with Basic auth) ----------------
#
#   let studio = Studio.new(username: "admin", password: "secret")
#   # or with an explicit root:
#   let studio = Studio.new(root: "../../studio/dist", username: "admin", password: "secret")
#
#   route get "/studio/{*filepath}" {
#       match authorize_studio(studio, request.headers) {
#           when success _ then match resolve_studio(studio, filepath) {
#               when success target then reply file target
#               when failure error then reply text explain(error) as "text/plain" status 404
#           }
#           when failure _ then reply text "unauthorized" as "text/plain" status 401
#       }
#   }

type Studio {
    root: Text = "studio/dist"
    username: Text
    password: Text
}

type StudioStorage {
    root: Text
    entries: [Text]
}

to studio_root() returns Text {
    match env.get("RIG_STUDIO_ROOT") {
        when found root then { return root }
        when nothing then {}
    }
    match File.read("studio/dist/index.html") {
        when success _ then { return "studio/dist" }
        when failure _ then {}
    }
    match File.read("vendor/rig/studio/dist/index.html") {
        when success _ then { return "vendor/rig/studio/dist" }
        when failure _ then {}
    }
    match File.read("../../studio/dist/index.html") {
        when success _ then { return "../../studio/dist" }
        when failure _ then {}
    }
    match env.get("HOME") {
        when found home then {
            let candidate = "{home}/.vaab/riffs/rig/studio/dist"
            match File.read("{candidate}/index.html") {
                when success _ then { return candidate }
                when failure _ then {}
            }
        }
        when nothing then {}
    }
    return "studio/dist"
}

to default_studio() returns Studio {
    let username = env.get("RIG_STUDIO_USER") otherwise "admin"
    let password = env.get("RIG_STUDIO_PASS") otherwise "secret"
    return Studio.new(root: studio_root(), username: username, password: password)
}

to mount_studio(username: Text, password: Text) returns Studio {
    return Studio.new(root: studio_root(), username: username, password: password)
}

to mount_studio_at(root: Text, username: Text, password: Text) returns Studio {
    return Studio.new(root: root, username: username, password: password)
}

to authorize_studio(studio: Studio, headers: {Text: Text}) returns Int or fails RigError {
    match headers.get("authorization") {
        when found value then {
            if basic_auth_ok(value, studio.username, studio.password) {
                return 1
            }
            fail RigError.Unauthorized
        }
        when nothing then match headers.get("Authorization") {
            when found value then {
                if basic_auth_ok(value, studio.username, studio.password) {
                    return 1
                }
                fail RigError.Unauthorized
            }
            when nothing then { fail RigError.Unauthorized }
        }
    }
}

to resolve_studio(studio: Studio, requested: Text) returns Text or fails RigError {
    if requested.contains("..") {
        fail RigError.Unsafe(requested)
    }
    # Empty path and client-side routes (no file extension) serve the SPA shell.
    if requested.is_empty {
        return "{studio.root}/index.html"
    }
    if requested.contains(".") {
        return "{studio.root}/{requested}"
    }
    return "{studio.root}/index.html"
}

