to save_policy(db: Db, body: StudioPolicyBody) returns Int or fails RigError {
    if not body.table_name.is_empty {
        let _r = try config_set(db, "rls:{body.table_name}", nonempty(body.rls_enabled, "true"))
    }
    if body.name.is_empty {
        return 1
    }
    let id = nonempty(body.id, "pol-{body.table_name}-{now()}")
    match db.from("studio_policies").equals("id", id).first() {
        when success maybe then match maybe {
            when found _ then match db.from("studio_policies").equals("id", id).update({
                "schema_name": nonempty(body.schema_name, "public"),
                "table_name": body.table_name,
                "name": body.name,
                "action": nonempty(body.action, "PERMISSIVE"),
                "roles": nonempty(body.roles, "public"),
                "command": body.command,
                "definition": nonempty(body.definition, "true"),
                "check_expr": body.check_expr,
            }) {
                when success count then { return count }
                when failure error then match error {
                    when Failed(message) then { fail RigError.Database(message) }
                }
            }
            when nothing then match db.from("studio_policies").insert({
                "id": id,
                "schema_name": nonempty(body.schema_name, "public"),
                "table_name": body.table_name,
                "name": body.name,
                "action": nonempty(body.action, "PERMISSIVE"),
                "roles": nonempty(body.roles, "public"),
                "command": body.command,
                "definition": nonempty(body.definition, "true"),
                "check_expr": body.check_expr,
            }) {
                when success count then { return count }
                when failure error then match error {
                    when Failed(message) then { fail RigError.Database(message) }
                }
            }
        }
        when failure error then match error {
            when Failed(message) then { fail RigError.Database(message) }
