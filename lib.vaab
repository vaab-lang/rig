# rig — Vaab's own Supabase-shaped backend helpers.
#
# tape is the static file deck. rig is the full backline: database REST,
# auth (via request.who), object storage paths, and a precompiled Studio UI —
# all mounted from a serve block.
#
#   need rig
#
#   serve on port 54321 {
#       mount rig_auth at "/auth/v1"
#       mount rig_api at "/rest/v1"
#       mount rig_storage at "/storage/v1"
#       mount rig_studio at "/studio"
#   }

choice RigError {
    Missing(name: Text)
    Database(message: Text)
    Unauthorized
    BadRequest(message: Text)
    NotFound(resource: Text)
    Forbidden(table: Text)
    Unsafe(requested: Text)
}

type Client {
    db_url: Text
    storage_root: Text
}

type Health {
    name: Text
    ok: Bool
    version: Text
}

# Same shape request.who expects (apps share this type via need rig).
type User {
    id: Text
    email: Text
}

type UserView {
    id: Text
    email: Text
}

type Actor {
    role: Text
    uid: Text
}

type RlsMode {
    kind: Text
    column: Text
}

type AuthSignupBody {
    email: Text
    password: Text
}

type AuthTokenBody {
    grant_type: Text = "password"
    email: Text = ""
    password: Text = ""
    refresh_token: Text = ""
}

type AuthUserResponse {
    id: Text
    email: Text
    role: Text
}

type AuthSession {
    access_token: Text
    refresh_token: Text
    token_type: Text
    expires_in: Int
    user: AuthUserResponse
}

type JwtClaims {
    role: Text
    sub: Text
    email: Text
    exp: Int
    iat: Int
}

type OkCount {
    count: Int
}

type RiffPackage {
    name: Text
    version: Text
    description: Text
    author: Text
    licence: Text
    repo: Text
    needs: Text
    tags: Text
    downloads: Int
    views: Int
}

type RiffTracked {
    ok: Bool
    downloads: Int
}

type RiffViewed {
    ok: Bool
    views: Int
}

type RegistryHealth {
    ok: Bool
    service: Text
}

# --- connect ---------------------------------------------------------------

to connect() returns Client or fails RigError {
    match require_env("RIG_DATABASE_URL") {
        when success db_url then match env.get("RIG_STORAGE_ROOT") {
            when found root then { return Client.new(db_url: db_url, storage_root: root) }
            when nothing then {
                return Client.new(db_url: db_url, storage_root: "rig-storage")
            }
        }
        when failure error then { fail error }
    }
}

to connect_with(db_url: Text, storage_root: Text) returns Client {
    return Client.new(db_url: db_url, storage_root: storage_root)
}

to require_env(name: Text) returns Text or fails RigError {
    match env.get(name) {
        when found value then { return value }
        when nothing then { fail RigError.Missing(name) }
    }
}

# --- database --------------------------------------------------------------

to open_url(db_url: Text) returns Db or fails RigError {
    match Db.connect(db_url) {
        when success db then match ensure_schema(db) {
            when success _ then { return db }
            when failure error then { fail error }
        }
        when failure error then match error {
            when Failed(message) then { fail RigError.Database(message) }
        }
    }
}

to open_db(client: Client) returns Db or fails RigError {
    return open_url(client.db_url)
}

to exec_sql(db: Db, sql: Text) returns Int or fails RigError {
    let empty: [Text] = []
    match db.execute(sql, empty) {
        when success count then { return count }
        when failure error then match error {
            when Failed(message) then { fail RigError.Database(message) }
        }
    }
}

to query_sql(db: Db, sql: Text) returns [{Text: Text}] or fails RigError {
    let empty: [Text] = []
    return try query_args(db, sql, empty)
}

to query_args(db: Db, sql: Text, args: [Text]) returns [{Text: Text}] or fails RigError {
    match db.query(sql, args) {
        when success rows then { return rows }
        when failure error then match error {
            when Failed(message) then { fail RigError.Database(message) }
        }
    }
}

to exec_args(db: Db, sql: Text, args: [Text]) returns Int or fails RigError {
    match db.execute(sql, args) {
        when success count then { return count }
        when failure error then match error {
            when Failed(message) then { fail RigError.Database(message) }
        }
    }
}

to row_text(row: {Text: Text}, key: Text) returns Text {
    return row.get(key) otherwise ""
}

to empty_rows() returns [{Text: Text}] {
    let none: [{Text: Text}] = []
    return none
}

to pragma_rows(db: Db, sql: Text) returns [{Text: Text}] {
    let empty: [Text] = []
    match db.query(sql, empty) {
        when success rows then { return rows }
        when failure _ then { return empty_rows() }
    }
}

to ident_ok(name: Text) returns Bool {
    if name.is_empty { return no }
    if name.contains(" ") { return no }
    if name.contains(";") { return no }
    if name.contains("'") { return no }
    if name.contains("\"") { return no }
    if name.contains("`") { return no }
    if name.contains("[") { return no }
    if name.contains("]") { return no }
    if name.contains("(") { return no }
    if name.contains(")") { return no }
    if name.contains(",") { return no }
    if name.contains(".") { return no }
    if name.contains("/") { return no }
    if name.contains("\\") { return no }
    if name.contains("=") { return no }
    if name.contains("*") { return no }
    if name.contains("%") { return no }
    if name.contains("#") { return no }
    if name.contains("-") { return no }
    if name.contains("--") { return no }
    if name.contains("/*") { return no }
    return yes
}

to ident(name: Text) returns Text or fails RigError {
    if ident_ok(name) {
        return name
    }
    fail RigError.BadRequest("bad identifier: {name}")
}

to names_ok(names: [Text], i: Int) returns Bool {
    if i >= names.count { return yes }
    if not ident_ok(names[i]) { return no }
    return names_ok(names, i + 1)
}

to values_ok(values: {Text: Text}) returns Bool {
    return names_ok(values.keys, 0)
}

to is_sqlite_name(name: Text) returns Bool {
    if name.contains("sqlite_") { return yes }
    if name == "sqlite_master" { return yes }
    return no
}

to is_credential_table(name: Text) returns Bool {
    if name == "studio_config" { return yes }
    if name == "auth_passwords" { return yes }
    if name == "auth_refresh_tokens" { return yes }
    return no
}

to allow_user_table(table: Text) returns Text or fails RigError {
    let name = try ident(table)
    if is_sqlite_name(name) {
        fail RigError.Forbidden(name)
    }
    if is_credential_table(name) {
        fail RigError.Forbidden(name)
    }
    return name
}

to schema_is_ready(db: Db) returns Bool {
    match db.from("studio_config").equals("key", "schema_ready_v2").first() {
        when success maybe then match maybe {
            when found _ then { return yes }
            when nothing then { return no }
        }
        when failure _ then { return no }
    }
}

to drop_legacy_todos_table(db: Db) returns Int {
    let empty: [Text] = []
    match db.execute("drop table if exists todos", empty) {
        when success count then { return count }
        when failure _ then { return 0 }
    }
}

to migrate_auth(db: Db) returns Int or fails RigError {
    let _tokens = try exec_sql(db, "create table if not exists auth_refresh_tokens (id text primary key, user_id text not null, token_hash text not null, expires_at text not null)")
    let _passwords = try exec_sql(db, "create table if not exists auth_passwords (user_id text primary key, password_hash text not null)")
    return _passwords + _tokens
}

to ensure_schema(db: Db) returns Int or fails RigError {
    if schema_is_ready(db) {
        let _m = try migrate_auth(db)
        return _m
    }
    let _legacy = drop_legacy_todos_table(db)
    let _p = try exec_sql(db, "create table if not exists profiles (id text primary key, email text not null, name text not null default '')")
    let _r = try exec_sql(db, "create table if not exists riff_events (id text primary key, name text not null, kind text not null, ts text not null)")
    let _rf = try exec_sql(db, "create table if not exists riffs (name text primary key, version text not null, description text not null, author text not null, licence text not null, repo text not null, needs text not null, tags text not null default '')")
    let _seed_riffs = try seed_registry(db)
    let _c = try exec_sql(db, "create table if not exists studio_config (key text primary key, value text not null)")
    let _u = try exec_sql(db, "create table if not exists auth_users (id text primary key, email text not null, phone text not null default '', provider text not null default 'email', created_at text not null, last_sign_in_at text not null default '', raw_user_meta_data text not null default '', banned_until text not null default '')")
    let _b = try exec_sql(db, "create table if not exists studio_buckets (id text primary key, name text not null, public text not null default 'false', file_size_limit text not null default '', allowed_mime_types text not null default '', created_at text not null, updated_at text not null)")
    let _o = try exec_sql(db, "create table if not exists studio_objects (id text primary key, bucket_id text not null, name text not null, size text not null default '0', mime_type text not null default '', content text not null default '', created_at text not null, updated_at text not null)")
    let _s = try exec_sql(db, "create table if not exists studio_snippets (id text primary key, name text not null, description text not null default '', sql text not null default '', folder text not null default 'Private', favorite text not null default 'false', visibility text not null default 'private', updated_at text not null)")
    let _l = try exec_sql(db, "create table if not exists studio_policies (id text primary key, schema_name text not null default 'public', table_name text not null, name text not null, action text not null default 'PERMISSIVE', roles text not null default 'public', command text not null, definition text not null default 'true', check_expr text not null default '')")
    let _f = try exec_sql(db, "create table if not exists studio_functions (id text primary key, slug text not null, name text not null, status text not null default 'active', version text not null default '1', entrypoint_path text not null default 'index.ts', verify_jwt text not null default 'true', code text not null default '', created_at text not null, updated_at text not null)")
    let _m = try exec_sql(db, "create table if not exists studio_migrations (version text primary key, name text not null, statements text not null default '', applied_at text not null)")
    let _g = try exec_sql(db, "create table if not exists studio_logs (id text primary key, ts text not null, service text not null, level text not null, status_code text not null default '', method text not null default '', path text not null default '', msg text not null default '', duration_ms text not null default '0')")
    let _w = try exec_sql(db, "create table if not exists studio_webhooks (id text primary key, name text not null, table_name text not null, events text not null default '', url text not null, method text not null default 'POST', headers text not null default '', enabled text not null default 'true', created_at text not null)")
    let _seeded = try seed_studio(db)
    let _ready = try config_set(db, "schema_ready_v2", "1")
    let _m = try migrate_auth(db)
    return _seeded + _m
}

to seed_studio(db: Db) returns Int or fails RigError {
    match db.from("studio_snippets").count() {
        when success n then {
            if n > 0 { return n }
            let ts = "{now()}"
            match db.from("studio_snippets").insert({"id": "tpl-create-table", "name": "Create table", "description": "Create a table", "sql": "create table items (id text primary key, name text not null)", "folder": "Templates", "favorite": "false", "visibility": "shared", "updated_at": ts}) {
                when success _ then {}
                when failure error then match error {
                    when Failed(message) then { fail RigError.Database(message) }
                }
            }
            match db.from("studio_snippets").insert({"id": "tpl-rls", "name": "Enable RLS read", "description": "Select for all users", "sql": "create policy read_all on items for select using (true)", "folder": "Templates", "favorite": "false", "visibility": "shared", "updated_at": ts}) {
                when success count then { return count }
                when failure error then match error {
                    when Failed(message) then { fail RigError.Database(message) }
                }
            }
        }
        when failure error then match error {
            when Failed(message) then { fail RigError.Database(message) }
        }
    }
}

# --- riff registry telemetry (riff.vaab.dev) --------------------------------

to seed_riff(
    db: Db,
    name: Text,
    version: Text,
    description: Text,
    author: Text,
    licence: Text,
    repo: Text,
    needs: Text,
    tags: Text,
) returns Int or fails RigError {
    match db.from("riffs").equals("name", name).first() {
        when success maybe then match maybe {
            when found _ then { return 0 }
            when nothing then {
                match db.from("riffs").insert({
                    "name": name,
                    "version": version,
                    "description": description,
                    "author": author,
                    "licence": licence,
                    "repo": repo,
                    "needs": needs,
                    "tags": tags,
                }) {
                    when success count then { return count }
                    when failure error then match error {
                        when Failed(message) then { fail RigError.Database(message) }
                    }
                }
            }
        }
        when failure error then match error {
            when Failed(message) then { fail RigError.Database(message) }
        }
    }
}

to seed_registry(db: Db) returns Int or fails RigError {
    try seed_riff(
        db,
        "rig",
        "0.1.0",
        "Supabase-shaped backend helpers for Vaab — Postgres/SQLite data API, auth adapter, storage paths, Studio, and riff install tracking.",
        "vaab-lang",
        "MIT",
        "https://github.com/vaab-lang/rig",
        "vaab at 0.1.4",
        "database,auth,storage,backend",
    )
    try seed_riff(
        db,
        "supabase",
        "0.1.0",
        "PostgREST client over Vaab’s http.send builtin. Connect, fetch, insert, patch, and delete rows.",
        "vaab",
        "MIT",
        "https://github.com/vaab-lang/vaab-riffs/tree/main/supabase",
        "vaab at 0.1",
        "database,api,supabase",
    )
    try seed_riff(
        db,
        "tape",
        "0.1.0",
        "Static file helpers for Vaab HTTP servers. Serve dist folders without a reverse proxy.",
        "vaab-lang",
        "MIT",
        "https://github.com/vaab-lang/tape",
        "vaab at 0.1",
        "http,static,server",
    )
    return 3
}

to known_riff(db: Db, name: Text) returns Bool {
    match db.from("riffs").equals("name", name).count() {
        when success count then { return count > 0 }
        when failure _ then { return no }
    }
}

to riff_name_ok(db: Db, name: Text) returns Bool {
    if name.is_empty { return no }
    if name.contains("..") { return no }
    if name.contains("/") { return no }
    if name.contains(":") { return no }
    if name.contains(" ") { return no }
    return known_riff(db, name)
}

to track_riff(db: Db, name: Text, kind: Text) returns Int or fails RigError {
    if not riff_name_ok(db, name) {
        fail RigError.BadRequest("unknown or bad riff name")
    }
    let existing = try count_riff_kind(db, name, kind)
    let next = existing + 1
    let id = "{name}-{kind}-{now()}-{next}"
    match db.from("riff_events").insert({"id": id, "name": name, "kind": kind, "ts": "{now()}"}) {
        when success _ then { return next }
        when failure error then match error {
            when Failed(message) then { fail RigError.Database(message) }
        }
    }
}

to count_riff_kind(db: Db, name: Text, kind: Text) returns Int or fails RigError {
    if not riff_name_ok(db, name) {
        fail RigError.BadRequest("unknown or bad riff name")
    }
    match db.from("riff_events").equals("name", name).where("kind").is(kind).count() {
        when success n then { return n }
        when failure error then match error {
            when Failed(message) then { fail RigError.Database(message) }
        }
    }
}

to count_riff(db: Db, name: Text) returns Int or fails RigError {
    if not riff_name_ok(db, name) {
        fail RigError.BadRequest("unknown or bad riff name")
    }
    match db.from("riff_events").equals("name", name).count() {
        when success n then { return n }
        when failure error then match error {
            when Failed(message) then { fail RigError.Database(message) }
        }
    }
}

to package_with_downloads(db: Db, name: Text) returns RiffPackage or fails RigError {
    match db.from("riffs").equals("name", name).first() {
        when success maybe then match maybe {
            when found row then {
                let downloads = try count_riff_kind(db, name, "install")
                let views = try count_riff_kind(db, name, "view")
                return RiffPackage.new(
                    name: row.get("name") otherwise name,
                    version: row.get("version") otherwise "0.0.0",
                    description: row.get("description") otherwise "",
                    author: row.get("author") otherwise "",
                    licence: row.get("licence") otherwise "",
                    repo: row.get("repo") otherwise "",
                    needs: row.get("needs") otherwise "",
                    tags: row.get("tags") otherwise "",
                    downloads: downloads,
                    views: views,
                )
            }
            when nothing then { fail RigError.NotFound(name) }
        }
        when failure error then match error {
            when Failed(message) then { fail RigError.Database(message) }
        }
    }
}

to catalog_riffs(db: Db) returns [RiffPackage] or fails RigError {
    try seed_registry(db)
    let rig_pkg = try package_with_downloads(db, "rig")
    let supabase = try package_with_downloads(db, "supabase")
    let tape = try package_with_downloads(db, "tape")
    return [rig_pkg, supabase, tape]
}

to install_history(db: Db, name: Text) returns [{Text: Text}] or fails RigError {
    if not riff_name_ok(db, name) {
        fail RigError.BadRequest("unknown or bad riff name")
    }
    let url = env.get("RIG_DATABASE_URL") otherwise ""
    if url.contains("postgres") {
        return history_postgres(db, name)
    }
    return history_sqlite(db, name)
}

to history_sqlite(db: Db, name: Text) returns [{Text: Text}] or fails RigError {
    let sql = "select strftime('%Y-%m-%d', cast(ts as integer), 'unixepoch') as day, cast(sum(case when kind = 'install' then 1 else 0 end) as text) as installs, cast(sum(case when kind = 'view' then 1 else 0 end) as text) as views from riff_events where name = $1 group by 1 order by day asc limit 30"
    let args: [Text] = [name]
    match db.query(sql, args) {
        when success rows then { return rows }
        when failure error then match error {
            when Failed(message) then { fail RigError.Database(message) }
        }
    }
}

to history_postgres(db: Db, name: Text) returns [{Text: Text}] or fails RigError {
    let sql = "select to_char(to_timestamp(ts::bigint), 'YYYY-MM-DD') as day, cast(sum(case when kind = 'install' then 1 else 0 end) as text) as installs, cast(sum(case when kind = 'view' then 1 else 0 end) as text) as views from riff_events where name = $1 group by 1 order by day asc limit 30"
    let args: [Text] = [name]
    match db.query(sql, args) {
        when success rows then { return rows }
        when failure error then match error {
            when Failed(message) then { fail RigError.Database(message) }
        }
    }
}

to is_postgres() returns Bool {
    let url = (env.get("RIG_DATABASE_URL") otherwise "").lower()
    if url.contains("postgres") { return yes }
    return no
}

to catalog_table_rows(db: Db) returns [{Text: Text}] or fails RigError {
    let pg_sql = "select cast(table_name as text) as name, case when table_type = 'VIEW' then 'view' else 'table' end as type, '' as sql from information_schema.tables where table_schema = 'public' and table_name != 'studio_config' and table_name != 'auth_passwords' and table_name != 'auth_refresh_tokens' order by table_name"
    let sqlite_sql = "select name, type, coalesce(sql, '') as sql from sqlite_master where type in ('table', 'view') and name not like 'sqlite_%' and name != 'studio_config' and name != 'auth_passwords' and name != 'auth_refresh_tokens' order by name"
    if is_postgres() {
        return try query_sql(db, pg_sql)
    }
    let empty: [Text] = []
    match db.query(sqlite_sql, empty) {
        when success rows then { return rows }
        when failure _ then { return try query_sql(db, pg_sql) }
    }
}

to studio_table_names(db: Db) returns [Text] or fails RigError {
    let rows = try catalog_table_rows(db)
    return rows.map(row -> row_text(row, "name"))
}

to has_table_name(names: [Text], target: Text, i: Int) returns Bool {
    if i >= names.count { return no }
    if names[i] == target { return yes }
    return has_table_name(names, target, i + 1)
}

to allow_studio_table(db: Db, table: Text) returns Text or fails RigError {
    let name = try allow_user_table(table)
    let names = try studio_table_names(db)
    if has_table_name(names, name, 0) {
        return name
    }
    fail RigError.NotFound(name)
}

to allow_table(table: Text) returns Text or fails RigError {
    return try allow_user_table(table)
}

to table_columns(db: Db, name: Text) returns [{Text: Text}] {
    if not ident_ok(name) { return empty_rows() }
    let pg_sql = "select cast(c.ordinal_position - 1 as text) as cid, cast(c.column_name as text) as name, cast(c.data_type as text) as type, case when c.is_nullable = 'NO' then '1' else '0' end as notnull, coalesce(cast(c.column_default as text), '') as dflt_value, case when exists (select 1 from information_schema.table_constraints tc join information_schema.key_column_usage kcu on tc.constraint_name = kcu.constraint_name and tc.table_schema = kcu.table_schema where tc.constraint_type = 'PRIMARY KEY' and tc.table_schema = 'public' and tc.table_name = '{name}' and kcu.column_name = c.column_name) then '1' else '0' end as pk from information_schema.columns c where c.table_schema = 'public' and c.table_name = '{name}' order by c.ordinal_position"
    if is_postgres() {
        return pragma_rows(db, pg_sql)
    }
    let cols = pragma_rows(db, "PRAGMA table_info({name})")
    if not cols.is_empty { return cols }
    return pragma_rows(db, pg_sql)
}

to table_foreign_keys(db: Db, name: Text) returns [{Text: Text}] {
    if not ident_ok(name) { return empty_rows() }
    let pg_sql = "select cast(kcu.column_name as text) as \"from\", cast(ccu.table_name as text) as \"table\", cast(ccu.column_name as text) as \"to\" from information_schema.table_constraints tc join information_schema.key_column_usage kcu on tc.constraint_name = kcu.constraint_name and tc.table_schema = kcu.table_schema join information_schema.constraint_column_usage ccu on ccu.constraint_name = tc.constraint_name and ccu.table_schema = tc.table_schema where tc.constraint_type = 'FOREIGN KEY' and tc.table_schema = 'public' and tc.table_name = '{name}'"
    if is_postgres() {
        return pragma_rows(db, pg_sql)
    }
    return pragma_rows(db, "PRAGMA foreign_key_list({name})")
}

to table_indexes(db: Db, name: Text) returns [{Text: Text}] {
    if not ident_ok(name) { return empty_rows() }
    let pg_sql = "select cast(indexname as text) as name, cast(indexdef as text) as origin from pg_indexes where schemaname = 'public' and tablename = '{name}'"
    if is_postgres() {
        return pragma_rows(db, pg_sql)
    }
    return pragma_rows(db, "PRAGMA index_list({name})")
}

to pk_from_cols(cols: [{Text: Text}], i: Int) returns Text {
    if i >= cols.count {
        if cols.is_empty { return "id" }
        let first = row_text(cols[0], "name")
        if first.is_empty { return "id" }
        return first
    }
    let col = cols[i]
    if row_text(col, "pk") == "1" {
        let pk_name = row_text(col, "name")
        if not pk_name.is_empty { return pk_name }
    }
    return pk_from_cols(cols, i + 1)
}

to primary_key(db: Db, table: Text) returns Text {
    if not ident_ok(table) { return "id" }
    return pk_from_cols(table_columns(db, table), 0)
}

to list(db: Db, table: Text) returns [{Text: Text}] or fails RigError {
    let name = try allow_studio_table(db, table)
    let pk = primary_key(db, name)
    match db.from(name).order_desc(pk).all() {
        when success rows then { return rows }
        when failure error then match error {
            when Failed(message) then { fail RigError.Database(message) }
        }
    }
}

to list_as(db: Db, table: Text, actor: Actor) returns [{Text: Text}] or fails RigError {
    let name = try allow_studio_table(db, table)
    let mode = try rls_mode(db, name, "select", actor)
    if mode.kind == "deny" or (mode.kind == "uid" and actor.uid.is_empty) {
        return empty_rows()
    }
    let pk = primary_key(db, name)
    let scoped = if mode.kind == "uid" {
        db.from(name).equals(mode.column, actor.uid).order_desc(pk)
    } else {
        db.from(name).order_desc(pk)
    }
    match scoped.all() {
        when success rows then { return rows }
        when failure error then match error {
            when Failed(message) then { fail RigError.Database(message) }
        }
    }
}

to get_as(db: Db, table: Text, id: Text, actor: Actor) returns {Text: Text} or fails RigError {
    let name = try allow_studio_table(db, table)
    let _ok = try assert_existing(db, name, "select", actor, id)
    return try get(db, name, id)
}

to insert_row_as(db: Db, table: Text, values: {Text: Text}, actor: Actor) returns Int or fails RigError {
    let name = try allow_studio_table(db, table)
    let _ok = try assert_values(db, name, "insert", actor, values, yes)
    return try insert_row(db, name, values)
}

to patch_row_as(db: Db, table: Text, id: Text, values: {Text: Text}, actor: Actor) returns Int or fails RigError {
    let name = try allow_studio_table(db, table)
    let _existing = try assert_existing(db, name, "update", actor, id)
    let _next = try assert_values(db, name, "update", actor, values, no)
    return try patch_row(db, name, id, values)
}

to remove_as(db: Db, table: Text, id: Text, actor: Actor) returns Int or fails RigError {
    let name = try allow_studio_table(db, table)
    let _ok = try assert_existing(db, name, "delete", actor, id)
    return try remove(db, name, id)
}

to list_where(db: Db, table: Text, column: Text, value: Text) returns [{Text: Text}] or fails RigError {
    let name = try allow_studio_table(db, table)
    let col = try ident(column)
    let pk = primary_key(db, name)
    match db.from(name).equals(col, value).order_desc(pk).all() {
        when success rows then { return rows }
        when failure error then match error {
            when Failed(message) then { fail RigError.Database(message) }
        }
    }
}

to get(db: Db, table: Text, id: Text) returns {Text: Text} or fails RigError {
    let name = try allow_studio_table(db, table)
    let pk = primary_key(db, name)
    match db.from(name).equals(pk, id).first() {
        when success maybe then match maybe {
            when found row then { return row }
            when nothing then { fail RigError.NotFound(id) }
        }
        when failure error then match error {
            when Failed(message) then { fail RigError.Database(message) }
        }
    }
}

to insert_profile(db: Db, id: Text, email: Text, name: Text) returns Int or fails RigError {
    match db.from("profiles").insert({"id": id, "email": email, "name": name}) {
        when success count then { return count }
        when failure error then match error {
            when Failed(message) then { fail RigError.Database(message) }
        }
    }
}

to insert_row(db: Db, table: Text, values: {Text: Text}) returns Int or fails RigError {
    let name = try allow_studio_table(db, table)
    if values.is_empty {
        fail RigError.BadRequest("values required")
    }
    if not values_ok(values) {
        fail RigError.BadRequest("bad column name")
    }
    match db.from(name).insert(values) {
        when success count then { return count }
        when failure error then match error {
            when Failed(message) then { fail RigError.Database(message) }
        }
    }
}

to patch_row(db: Db, table: Text, id: Text, values: {Text: Text}) returns Int or fails RigError {
    let name = try allow_studio_table(db, table)
    if id.is_empty {
        fail RigError.BadRequest("id required")
    }
    if values.is_empty {
        fail RigError.BadRequest("values required")
    }
    if not values_ok(values) {
        fail RigError.BadRequest("bad column name")
    }
    let pk = primary_key(db, name)
    match db.from(name).equals(pk, id).update(values) {
        when success count then {
            if count == 0 { fail RigError.NotFound(id) }
            return count
        }
        when failure error then match error {
            when Failed(message) then { fail RigError.Database(message) }
        }
    }
}

to remove(db: Db, table: Text, id: Text) returns Int or fails RigError {
    let name = try allow_studio_table(db, table)
    let pk = primary_key(db, name)
    match db.from(name).equals(pk, id).delete() {
        when success count then {
            if count == 0 { fail RigError.NotFound(id) }
            return count
        }
        when failure error then match error {
            when Failed(message) then { fail RigError.Database(message) }
        }
    }
}

# --- auth (builtin request.who; rig only adapts) ---------------------------

to require_user(who: User or fails AuthError) returns User or fails RigError {
    match who {
        when success user then { return user }
        when failure _ then { fail RigError.Unauthorized }
    }
}

to user_view(user: User) returns UserView {
    return UserView.new(id: user.id, email: user.email)
}

# --- object storage paths (tape's sibling for /storage) --------------------

to resolve_object(root: Text, requested: Text) returns Text or fails RigError {
    if requested.contains("..") {
        fail RigError.Unsafe(requested)
    }
    if requested.is_empty {
        fail RigError.BadRequest("empty object path")
    }
    return "{root}/{requested}"
}

# --- Studio (tape-shaped static mount, gated with Basic auth) ----------------
#
#   let studio = Studio.new(username: "admin", password: "secret")
#   # or with an explicit root:
#   let studio = Studio.new(root: "../../studio/dist", username: "admin", password: "secret")
#
#   route get "/studio/{*filepath}" {
#       match authorize_studio(studio, request.headers) {
#           when success _ then match resolve_studio(studio, filepath) {
#               when success target then reply file target
#               when failure error then reply text explain(error) as "text/plain" status 404
#           }
#           when failure _ then reply text "unauthorized" as "text/plain" status 401
#       }
#   }

type Studio {
    root: Text = "studio/dist"
    username: Text
    password: Text
}

type StudioStorage {
    root: Text
    entries: [Text]
}

to studio_root() returns Text {
    match env.get("RIG_STUDIO_ROOT") {
        when found root then { return root }
        when nothing then {}
    }
    match File.read("studio/dist/index.html") {
        when success _ then { return "studio/dist" }
        when failure _ then {}
    }
    match File.read("vendor/rig/studio/dist/index.html") {
        when success _ then { return "vendor/rig/studio/dist" }
        when failure _ then {}
    }
    match File.read("../../studio/dist/index.html") {
        when success _ then { return "../../studio/dist" }
        when failure _ then {}
    }
    match env.get("HOME") {
        when found home then {
            let candidate = "{home}/.vaab/riffs/rig/studio/dist"
            match File.read("{candidate}/index.html") {
                when success _ then { return candidate }
                when failure _ then {}
            }
        }
        when nothing then {}
    }
    return "studio/dist"
}

to default_studio() returns Studio {
    let username = env.get("RIG_STUDIO_USER") otherwise "admin"
    let password = env.get("RIG_STUDIO_PASS") otherwise "secret"
    return Studio.new(root: studio_root(), username: username, password: password)
}

to mount_studio(username: Text, password: Text) returns Studio {
    return Studio.new(root: studio_root(), username: username, password: password)
}

to mount_studio_at(root: Text, username: Text, password: Text) returns Studio {
    return Studio.new(root: root, username: username, password: password)
}

to authorize_studio(studio: Studio, headers: {Text: Text}) returns Int or fails RigError {
    match headers.get("authorization") {
        when found value then {
            if basic_auth_ok(value, studio.username, studio.password) {
                return 1
            }
            fail RigError.Unauthorized
        }
        when nothing then match headers.get("Authorization") {
            when found value then {
                if basic_auth_ok(value, studio.username, studio.password) {
                    return 1
                }
                fail RigError.Unauthorized
            }
            when nothing then { fail RigError.Unauthorized }
        }
    }
}

to resolve_studio(studio: Studio, requested: Text) returns Text or fails RigError {
    if requested.contains("..") {
        fail RigError.Unsafe(requested)
    }
    # Empty path and client-side routes (no file extension) serve the SPA shell.
    if requested.is_empty {
        return "{studio.root}/index.html"
    }
    if requested.contains(".") {
        return "{studio.root}/{requested}"
    }
    return "{studio.root}/index.html"
}

