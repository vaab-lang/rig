# rig server — Supabase-shaped backline + Studio dashboard.
#
#   cd examples/server
#   /path/to/vaab gather
#   RIG_DATABASE_URL=sqlite:../../rig.db AUTH_SECRET=dev \
#     /path/to/vaab serve main.vaab
#
# Studio UI:  http://127.0.0.1:54321/studio/   (Basic auth: admin / secret)
# API:        http://127.0.0.1:54321/rest/v1/...

need rig

serve on port 54321 {
    mount rig_auth at "/auth/v1"
    mount rig_api at "/rest/v1"
    mount rig_storage at "/storage/v1"
    mount rig_functions at "/functions/v1"
    mount rig_studio at "/studio"

    socket "/realtime/v1/websocket" as client {
        rig.listen_realtime(client)
    }
}
