# rig server — Supabase-shaped backline + Studio dashboard.
#
#   cd ../../studio && npm install && npm run build
#   cd ../examples/server
#   /path/to/vaab gather
#   RIG_DATABASE_URL=sqlite:../../rig.db AUTH_SECRET=dev \
#     /path/to/vaab serve main.vaab
#
# Studio UI:  http://127.0.0.1:54321/
# API:        http://127.0.0.1:54321/rest/v1/...

need rig of RigError, Client, User, UserView, Health, NewTodo, OkCount, Todo, connect, connect_with, open_db, open_url, require_env, ensure_schema, allow_table, list, list_where, get, insert_todo, insert_profile, patch_todo_done, remove, require_user, user_view, resolve_object, health, auth_health

type StudioTable {
    name: Text
    columns: [Text]
}

type StudioSqlBody {
    sql: Text
}

type StudioStorage {
    root: Text
    entries: [Text]
}

serve on port 54321 {
    route get "/health" {
        reply with health()
    }

    route get "/auth/v1/health" {
        reply with auth_health()
    }

    route get "/auth/v1/user" {
        match RigRoutes.user(request.who) {
            when success view then { reply with view }
            when failure error then { reply text explain(error) as "text/plain" status 401 }
        }
    }

    route get "/rest/v1/todos" {
        match RigRoutes.list_todos() {
            when success rows then { reply with rows }
            when failure error then { reply text explain(error) as "text/plain" status 500 }
        }
    }

    route post "/rest/v1/todos" expecting NewTodo as body {
        match RigRoutes.create_todo(request.who, body) {
            when success count then { reply with count status 201 }
            when failure error then { reply text explain(error) as "text/plain" status 400 }
        }
    }

    route get "/rest/v1/profiles" {
        match RigRoutes.list_profiles() {
            when success rows then { reply with rows }
            when failure error then { reply text explain(error) as "text/plain" status 500 }
        }
    }

    route get "/storage/v1/object/{*filepath}" {
        match RigRoutes.storage_file(filepath) {
            when success target then {
                reply file target
            }
            when failure error then {
                reply text explain(error) as "text/plain; charset=utf-8" status 400
            }
        }
    }

    route get "/studio-api/tables" {
        reply with [
            StudioTable.new(name: "todos", columns: ["id", "title", "owner", "done"]),
            StudioTable.new(name: "profiles", columns: ["id", "email", "name"]),
        ]
    }

    route post "/studio-api/sql" expecting StudioSqlBody as body {
        match RigRoutes.run_select(body.sql) {
            when success rows then { reply with rows }
            when failure error then {
                reply text explain(error) as "text/plain; charset=utf-8" status 400
            }
        }
    }

    route get "/studio-api/storage" {
        match RigRoutes.storage_listing() {
            when success listing then { reply with listing }
            when failure error then {
                reply text explain(error) as "text/plain; charset=utf-8" status 500
            }
        }
    }

    route get "/" {
        reply file "../../studio/dist/index.html"
    }

    route get "/editor" {
        reply file "../../studio/dist/index.html"
    }

    route get "/sql" {
        reply file "../../studio/dist/index.html"
    }

    route get "/database" {
        reply file "../../studio/dist/index.html"
    }

    route get "/auth" {
        reply file "../../studio/dist/index.html"
    }

    route get "/storage" {
        reply file "../../studio/dist/index.html"
    }

    route get "/api" {
        reply file "../../studio/dist/index.html"
    }

    route get "/settings" {
        reply file "../../studio/dist/index.html"
    }

    route get "/assets/{*filepath}" {
        if filepath.contains("..") {
            reply text "forbidden" as "text/plain" status 403
        } else {
            reply file "../../studio/dist/assets/{filepath}"
        }
    }

    route get "/rig-mark.svg" {
        reply file "../../studio/dist/rig-mark.svg"
    }
}

cast RigRoutes {
    factory client() returns Client or fails RigError {
        match env.get("RIG_DATABASE_URL") {
            when found url then match env.get("RIG_STORAGE_ROOT") {
                when found root then { return connect_with(url, root) }
                when nothing then { return connect_with(url, "rig-storage") }
            }
            when nothing then { return try connect() }
        }
    }

    factory db_url() returns Text or fails RigError {
        match env.get("RIG_DATABASE_URL") {
            when found url then { return url }
            when nothing then { fail RigError.Missing("RIG_DATABASE_URL") }
        }
    }

    factory storage_root() returns Text or fails RigError {
        match env.get("RIG_STORAGE_ROOT") {
            when found root then { return root }
            when nothing then { return "rig-storage" }
        }
    }

    factory db() returns Db or fails RigError {
        let client = try RigRoutes.client()
        return open_db(client)
    }

    factory list_todos() returns [{Text: Text}] or fails RigError {
        let db = try RigRoutes.db()
        return list(db, "todos")
    }

    factory list_profiles() returns [{Text: Text}] or fails RigError {
        let db = try RigRoutes.db()
        return list(db, "profiles")
    }

    factory user(who: User or fails AuthError) returns UserView or fails RigError {
        let user = try require_user(who)
        return user_view(user)
    }

    factory create_todo(who: User or fails AuthError, body: NewTodo) returns OkCount or fails RigError {
        let user = try require_user(who)
        let db = try RigRoutes.db()
        let id = "{user.id}-{body.title}"
        let count = try insert_todo(db, id, body.title, user.id)
        return OkCount.new(count: count)
    }

    factory storage_file(filepath: Text) returns Text or fails RigError {
        let root = try RigRoutes.storage_root()
        return try resolve_object(root, filepath)
    }

    factory storage_listing() returns StudioStorage or fails RigError {
        let root = try RigRoutes.storage_root()
        let empty: [Text] = []
        return StudioStorage.new(root: root, entries: empty)
    }

    factory run_select(sql: Text) returns [{Text: Text}] or fails RigError {
        if sql.is_empty {
            fail RigError.BadRequest("empty sql")
        }
        let lowered = sql.lower()
        if not lowered.contains("select") {
            fail RigError.BadRequest("only select is allowed")
        }
        if lowered.contains("insert") {
            fail RigError.BadRequest("only select is allowed")
        }
        if lowered.contains("update") {
            fail RigError.BadRequest("only select is allowed")
        }
        if lowered.contains("delete") {
            fail RigError.BadRequest("only select is allowed")
        }
        if lowered.contains("drop") {
            fail RigError.BadRequest("only select is allowed")
        }
        if lowered.contains(";") {
            fail RigError.BadRequest("single statement only")
        }
        let url = try RigRoutes.db_url()
        match Db.connect(url) {
            when success db then {
                let empty: [Text] = []
                match db.query(sql, empty) {
                    when success rows then { return rows }
                    when failure error then match error {
                        when Failed(message) then { fail RigError.Database(message) }
                    }
                }
            }
            when failure error then match error {
                when Failed(message) then { fail RigError.Database(message) }
            }
        }
    }
}

explain(error: RigError) returns Text {
    match error {
        when Missing(name) then { return "missing {name}" }
        when Database(message) then { return message }
        when Unauthorized then { return "unauthorized" }
        when BadRequest(message) then { return message }
        when NotFound(resource) then { return "not found: {resource}" }
        when Forbidden(table) then { return "forbidden {table}" }
        when Unsafe(requested) then { return "unsafe {requested}" }
    }
}
